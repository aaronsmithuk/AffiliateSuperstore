@page "/admin/automation"
@layout AdminLayout
@attribute [Authorize(Policy = AdminAuthorization.PolicyName)]
@rendermode InteractiveServer
@inject IDbContextFactory<AffiliateSuperstoreDbContext> ContextFactory
@inject IOptions<CatalogueAutomationOptions> AutomationOptions
@inject AffiliateSuperstoreOptions SuperstoreOptions
@inject TimeProvider TimeProvider
@inject AutomationWorkQueueService WorkQueue
@inject CatalogueAutomationMonitorService MonitorService
@inject AutonomousPilotReportService PilotReportService
@inject AffiliateSuperstore.Web.Services.CatalogueAutomationWakeSignal WakeSignal
@inject AutonomousCataloguePolicyService PolicyService
@inject AutonomousCatalogueOptions AutonomousOptions
@inject AiAutomationOptions AiOptions
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Catalogue automation</PageTitle>

<header class="admin-topbar">
    <div>
        <p class="eyebrow">Operations</p>
        <h1>Catalogue automation</h1>
        <p class="lede">Restart-safe scheduling with idempotent SQL work items, recoverable leases and bounded retries.</p>
    </div>
    <div class="button-row">
        <button class="button refresh-button" type="button" @onclick="LoadAsync" disabled="@IsBusy">Refresh</button>
        <button class="button button-primary refresh-button" type="button" @onclick="WakeWorkerAsync" disabled="@(!Options.Enabled || IsBusy)">Wake worker</button>
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(ActionMessage))
{
    <div class="alert-card @(ActionFailed ? "error-card" : "success-card")" role="status"><strong>@(ActionFailed ? "Action failed" : "Automation updated")</strong><span>@ActionMessage</span></div>
}

<section class="database-hero @(Options.Enabled ? "healthy" : "unhealthy")">
    <div>
        <p class="eyebrow">Worker</p>
        <h2>@(Options.Enabled ? "Automatic refresh is enabled" : "Automatic refresh is disabled")</h2>
        <p>The worker checks every @Options.PollEveryMinutes minutes and refreshes successful catalogues every @Options.RefreshEveryHours hours. The external wake URL @(string.IsNullOrWhiteSpace(Options.WakeToken) ? "is not configured" : "requires its configured secret").</p>
    </div>
    <span class="database-health">@(Options.Enabled ? "Running" : "Off")</span>
</section>

<section class="panel autonomous-policy-panel">
    <div class="panel-heading">
        <div>
            <p class="eyebrow">Controlled autonomy</p>
            <h2>Autonomous catalogue policy</h2>
            <p class="panel-copy">Shadow mode prepares AI drafts and records publish-or-hold decisions without changing the public catalogue.</p>
        </div>
        @if (PolicyEditor is not null)
        {
            <span class="result-badge @ModeClass(PolicyEditor.Mode)">@PolicyEditor.Mode</span>
        }
    </div>
    @if (Policies.Count == 0 || PolicyEditor is null)
    {
        <p class="database-empty">No enabled shop has an autonomous policy.</p>
    }
    else
    {
        <div class="autonomous-policy-grid">
            <div class="autonomous-policy-form">
                <div class="form-field">
                    <label for="autonomous-shop">Shop</label>
                    <select id="autonomous-shop" value="@SelectedPolicySlug" @onchange="PolicySelectionChanged" disabled="@IsBusy">
                        @foreach (var policy in Policies)
                        {
                            <option value="@policy.ShopSlug">@policy.ShopName</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label for="autonomous-mode">Mode</label>
                    <select id="autonomous-mode" @bind="PolicyEditor.Mode" disabled="@IsBusy">
                        <option value="@AutonomousCatalogueMode.Off">Off</option>
                        <option value="@AutonomousCatalogueMode.Shadow">Shadow</option>
                        <option value="@AutonomousCatalogueMode.Automatic" disabled="@(!AutonomousOptions.AutomaticPublishingEnabled)">Automatic</option>
                    </select>
                    @if (!AutonomousOptions.AutomaticPublishingEnabled)
                    {
                        <small>Automatic publication is globally locked while shadow decisions are calibrated.</small>
                    }
                </div>
                <div class="form-row">
                    <div class="form-field">
                        <label for="review-cadence">Review every (hours)</label>
                        <input id="review-cadence" type="number" min="1" max="720" @bind="PolicyEditor.ReviewEveryHours" disabled="@IsBusy" />
                    </div>
                    <div class="form-field">
                        <label for="candidate-limit">Candidates per run</label>
                        <input id="candidate-limit" type="number" min="1" max="10" @bind="PolicyEditor.MaximumCandidatesPerRun" disabled="@IsBusy" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-field">
                        <label for="readiness-score">Minimum readiness</label>
                        <input id="readiness-score" type="number" min="0.5" max="1" step="0.01" @bind="PolicyEditor.MinimumReadinessScore" disabled="@IsBusy" />
                    </div>
                    <div class="form-field">
                        <label for="duplicate-threshold">Duplicate hold</label>
                        <input id="duplicate-threshold" type="number" min="0.5" max="1" step="0.01" @bind="PolicyEditor.DuplicateHoldConfidence" disabled="@IsBusy" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-field">
                        <label for="ai-daily-budget">Daily AI budget (USD)</label>
                        <input id="ai-daily-budget" type="number" min="0" max="100" step="0.01" @bind="PolicyEditor.DailyAiBudgetUsd" disabled="@IsBusy" />
                    </div>
                    <div class="form-field">
                        <label for="publish-limit">Daily publication limit</label>
                        <input id="publish-limit" type="number" min="1" max="100" @bind="PolicyEditor.MaximumAutoPublishesPerDay" disabled="@IsBusy" />
                    </div>
                </div>
                <div class="button-row">
                    <button class="button button-primary" type="button" @onclick="SavePolicyAsync" disabled="@IsBusy">Save policy</button>
                </div>
                <small>Last updated @LocalTime(PolicyEditor.UpdatedUtc) by @PolicyEditor.UpdatedBy.</small>
                @if (PolicyEditor.IsAutomaticallyPaused)
                {
                    <div class="alert-card warning-card automation-note" role="alert">
                        <strong>Automatic publication paused itself</strong>
                        <span>@PolicyEditor.AutomaticPauseReason. Review the affected work item or AI audit, then select Automatic and save the policy to acknowledge the incident and re-arm publishing.</span>
                    </div>
                }
            </div>
            <div class="autonomous-safety-card">
                <p class="eyebrow">Hard publication gates</p>
                <h3>AI cannot override these checks</h3>
                <ul>
                    <li>Active, eligible and recently checked source product</li>
                    <li>Available offer with a positive price and active affiliate link</li>
                    <li>Published-shop collection assignment</li>
                    <li>No quality, suitability or unsupported-claim flags</li>
                    <li>No confirmed or high-confidence probable duplicate</li>
                    <li>Audited AI provenance with an unchanged validated draft</li>
                </ul>
            </div>
        </div>
    }
</section>

@if (PilotReport is not null)
{
    <section class="panel catalogue-table-panel">
        <div class="panel-heading">
            <div>
                <p class="eyebrow">Seven-day evidence window</p>
                <h2>Restricted automatic pilot</h2>
                <p class="panel-copy">UTC evidence from @PilotReport.WindowStartUtc.ToString("dd MMM") through @PilotReport.WindowEndUtc.AddDays(-1).ToString("dd MMM yyyy"). Empty days remain visible so observation coverage is not overstated.</p>
            </div>
            <span class="result-badge @PilotStatusClass(PilotReport)">@PilotStatusLabel(PilotReport)</span>
        </div>
        <div class="metric-grid" aria-label="Automatic pilot health">
            <article class="metric-card"><strong>@PilotReport.AutomaticEvaluations</strong><span>Automatic decisions</span></article>
            <article class="metric-card"><strong>@PilotReport.Published</strong><span>Automatic publications</span></article>
            <article class="metric-card"><strong>@PilotReport.Held</strong><span>Held decisions</span></article>
            <article class="metric-card"><strong>@PilotReport.ActiveObservationDays / 7</strong><span>Days with automatic decisions</span></article>
            <article class="metric-card"><strong>@PilotAge(PilotReport)</strong><span>Elapsed pilot observation</span></article>
            <article class="metric-card"><strong>$@PilotReport.AiSpendUsd.ToString("0.0000")</strong><span>Product-copy AI spend</span></article>
            <article class="metric-card"><strong>@PilotReport.AiFailures</strong><span>AI failures</span></article>
            <article class="metric-card"><strong>@PilotReport.BudgetBlocks</strong><span>Budget blocks</span></article>
            <article class="metric-card"><strong>@PilotReport.DeadLetterReviews</strong><span>Review dead letters</span></article>
            <article class="metric-card"><strong>@PilotReport.SafetyPausedPolicies</strong><span>Safety-paused policies</span></article>
        </div>
        <div class="alert-card @PromotionAlertClass(PilotReport.Promotion.State) automation-note" role="status">
            <strong>Limit recommendation: @PromotionLabel(PilotReport.Promotion.State)</strong>
            <span>This is deterministic decision support only. It never changes the policy, candidate limit, publication cap or AI budget.</span>
            <ul class="validation-findings">
                @foreach (var finding in PilotReport.Promotion.Findings)
                {
                    <li>@finding</li>
                }
            </ul>
        </div>
        <div class="table-scroll">
            <table class="admin-table">
                <thead><tr><th>UTC date</th><th>Automatic</th><th>Shadow</th><th>Publishable</th><th>Held</th><th>Published</th><th>AI calls</th><th>Failures / blocks</th><th>Spend</th></tr></thead>
                <tbody>
                @foreach (var day in PilotReport.Days.OrderByDescending(item => item.Date))
                {
                    <tr>
                        <td><strong>@day.Date.ToString("dd MMM yyyy")</strong></td>
                        <td>@day.AutomaticEvaluations</td>
                        <td>@day.ShadowEvaluations</td>
                        <td>@day.WouldPublish</td>
                        <td>@day.Held</td>
                        <td>@day.Published</td>
                        <td>@day.AiCalls</td>
                        <td>@day.AiFailures / @day.BudgetBlocks</td>
                        <td>$@day.AiSpendUsd.ToString("0.0000")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}

<section class="metric-grid" aria-label="Autonomous shadow results">
    <article class="metric-card"><strong>@RecentDecisionRows.Count</strong><span>Recent decisions</span></article>
    <article class="metric-card"><strong>@RecentDecisionRows.Count(item => item.Decision == AutonomousCatalogueDecision.WouldPublish)</strong><span>Would publish</span></article>
    <article class="metric-card"><strong>@RecentDecisionRows.Count(item => item.Decision == AutonomousCatalogueDecision.Hold)</strong><span>Held for review</span></article>
    <article class="metric-card"><strong>@RecentDecisionRows.Count(item => item.Action == AutonomousCatalogueAction.Published)</strong><span>Actually published</span></article>
</section>

<section class="metric-grid" aria-label="AI budget">
    <article class="metric-card"><strong>$@AiMonthSpend.ToString("0.0000")</strong><span>AI spend this UTC month</span></article>
    <article class="metric-card"><strong>$@AiOptions.MonthlyBudgetUsd.ToString("0.00")</strong><span>Hard monthly AI cap</span></article>
    <article class="metric-card"><strong>$@Math.Max(0m, AiOptions.MonthlyBudgetUsd - AiMonthSpend).ToString("0.0000")</strong><span>Remaining AI budget</span></article>
    <article class="metric-card"><strong>@AiCallsThisMonth</strong><span>Charged AI calls this month</span></article>
</section>

<section class="panel catalogue-table-panel">
    <div class="panel-heading"><div><p class="eyebrow">Decision audit</p><h2>Recent autonomous evaluations</h2></div><span class="count-badge">@RecentDecisionRows.Count</span></div>
    @if (RecentDecisionRows.Count == 0)
    {
        <p class="database-empty">The first shadow decisions will appear after the scheduled worker runs.</p>
    }
    else
    {
        <div class="table-scroll"><table class="admin-table"><thead><tr><th>Evaluated</th><th>Product</th><th>Decision</th><th>Score</th><th>Mode / action</th><th>Reason</th></tr></thead><tbody>
        @foreach (var decision in RecentDecisionRows)
        {
            <tr>
                <td>@LocalTime(decision.EvaluatedUtc)</td>
                <td><strong>@decision.ProductTitle</strong><small>@decision.ProductId · @decision.ShopSlug · editorial v@decision.EditorialVersionNumber</small></td>
                <td><span class="result-badge @DecisionClass(decision.Decision)">@DecisionLabel(decision.Decision)</span></td>
                <td>@decision.ReadinessScore.ToString("P0")</td>
                <td><span>@decision.Mode</span><small>@decision.Action</small></td>
                <td><span>@decision.Summary</span>@if (!string.IsNullOrWhiteSpace(decision.ReasonCodes)) { <small>@decision.ReasonCodes</small> }</td>
            </tr>
        }
        </tbody></table></div>
    }
</section>

@if (Monitoring is not null)
{
    <section class="metric-grid" aria-label="Catalogue health">
        <article class="metric-card"><strong>@Monitoring.PublishedProducts</strong><span>Published products</span></article>
        <article class="metric-card"><strong>@Monitoring.FreshProducts</strong><span>Fresh products</span></article>
        <article class="metric-card"><strong>@Monitoring.StaleProducts</strong><span>Stale products</span></article>
        <article class="metric-card"><strong>@Monitoring.NeverCheckedProducts</strong><span>Never detail-checked</span></article>
        <article class="metric-card"><strong>@Monitoring.SuspectedUnavailableProducts</strong><span>Availability watch</span></article>
        <article class="metric-card"><strong>@Monitoring.ConfirmedUnavailableProducts</strong><span>Hidden unavailable</span></article>
        <article class="metric-card"><strong>@Monitoring.StaleLinks</strong><span>Stale links</span></article>
        <article class="metric-card"><strong>@Monitoring.FailedRunsInAlertWindow</strong><span>Recent failed runs</span></article>
    </section>

    <section aria-label="Operational alerts">
        @foreach (var alert in Monitoring.Alerts)
        {
            <div class="alert-card @AlertClass(alert.Severity)"><strong>@alert.Title</strong><span>@alert.Detail</span></div>
        }
    </section>
}

<section class="metric-grid" aria-label="Automation settings">
    <article class="metric-card"><strong>@Options.PageSize</strong><span>Products per request</span></article>
    <article class="metric-card"><strong>@DiscoveryRequestCount</strong><span>Discovery requests</span></article>
    <article class="metric-card"><strong>@Options.RefreshEveryHours h</strong><span>Normal refresh</span></article>
    <article class="metric-card"><strong>@Options.FailureRetryMinutes min</strong><span>Failure retry</span></article>
    <article class="metric-card"><strong>@Options.StaleJobHours h</strong><span>Stale-job threshold</span></article>
    <article class="metric-card"><strong>@Options.LinkRefreshHours h</strong><span>Link validation age</span></article>
    <article class="metric-card"><strong>@(QueueHealth?.Pending ?? 0)</strong><span>Pending work</span></article>
    <article class="metric-card"><strong>@(QueueHealth?.Leased ?? 0)</strong><span>Active leases</span></article>
    <article class="metric-card"><strong>@(QueueHealth?.RetryWaiting ?? 0)</strong><span>Waiting to retry</span></article>
    <article class="metric-card"><strong>@(QueueHealth?.ExpiredLeases ?? 0)</strong><span>Recoverable leases</span></article>
    <article class="metric-card"><strong>@(QueueHealth?.DeadLetters ?? 0)</strong><span>Dead letters</span></article>
</section>

<section class="panel catalogue-table-panel">
    <div class="panel-heading"><div><p class="eyebrow">Durable queue</p><h2>Recent work items</h2></div><span class="count-badge">@WorkItems.Count</span></div>
    @if (WorkItems.Count == 0)
    {
        <p class="database-empty">No durable automation work has been planned yet.</p>
    }
    else
    {
        <div class="table-scroll"><table class="admin-table"><thead><tr><th>Type</th><th>Shop</th><th>Status</th><th>Attempts</th><th>Available / completed</th><th>Lease</th><th>Result / action</th></tr></thead><tbody>
        @foreach (var item in WorkItems)
        {
            <tr>
                <td><strong>@item.Type</strong><small>@item.IdempotencyKey</small></td>
                <td>@(item.ShopSlug ?? "—")</td>
                <td><span class="result-badge @WorkStatusClass(item.Status)">@item.Status</span>@if (!string.IsNullOrWhiteSpace(item.LastError)) { <small title="@item.LastError">@ShortError(item.LastError)</small> }</td>
                <td>@item.AttemptCount / @item.MaximumAttempts</td>
                <td>@LocalTime(item.CompletedUtc ?? item.AvailableUtc)</td>
                <td>@if (item.Status == AutomationWorkStatus.Leased) { <span>@LocalTime(item.LeaseExpiresUtc)</span><small>@item.LeaseOwner</small> } else { <span>—</span> }</td>
                <td>
                    <span>@(item.ResultJobId?.ToString() ?? "—")</span>
                    @if (item.Status == AutomationWorkStatus.DeadLetter)
                    {
                        <button class="button refresh-button" type="button" @onclick="() => RetryAsync(item.Id)" disabled="@IsBusy">Retry</button>
                    }
                </td>
            </tr>
        }
        </tbody></table></div>
    }
</section>

<section class="panel catalogue-table-panel">
    <div class="panel-heading"><div><p class="eyebrow">Run history</p><h2>Recent catalogue jobs</h2></div><span class="count-badge">@JobRuns.Count</span></div>
    @if (JobRuns.Count == 0)
    {
        <p class="database-empty">No catalogue jobs have run yet.</p>
    }
    else
    {
        <div class="table-scroll"><table class="admin-table"><thead><tr><th>Started</th><th>Type</th><th>Shop</th><th>Status</th><th>Read</th><th>Written</th><th>Rejected</th><th>Duration</th><th>Checkpoint / error</th></tr></thead><tbody>
        @foreach (var job in JobRuns)
        {
            <tr>
                <td>@LocalTime(job.StartedUtc ?? job.QueuedUtc)</td>
                <td><strong>@job.Type</strong><small>@job.Id</small></td>
                <td>@(job.ShopSlug ?? "—")</td>
                <td><span class="result-badge @StatusClass(job.Status)">@job.Status</span></td>
                <td>@job.ItemsRead</td>
                <td>@job.ItemsWritten</td>
                <td>@job.ItemsRejected</td>
                <td>@Duration(job.StartedUtc, job.CompletedUtc)</td>
                <td><small title="@(job.ErrorSummary ?? job.Checkpoint)">@ShortError(job.ErrorSummary ?? job.Checkpoint ?? "—")</small></td>
            </tr>
        }
        </tbody></table></div>
    }
</section>

<section class="panel catalogue-table-panel">
    <div class="panel-heading"><div><p class="eyebrow">Schedule</p><h2>Shop refresh state</h2></div><span class="count-badge">@Shops.Count</span></div>
    @if (IsLoading && Shops.Count == 0)
    {
        <p class="database-empty">Loading schedule…</p>
    }
    else
    {
        <div class="table-scroll"><table class="admin-table"><thead><tr><th>Shop</th><th>Last status</th><th>Last completed</th><th>Next normal refresh</th><th>Due now</th></tr></thead><tbody>
        @foreach (var shop in Shops)
        {
            <tr>
                <td><strong>@shop.DisplayName</strong><small>/@shop.Slug</small></td>
                <td><span class="result-badge @StatusClass(shop.Status)">@(shop.Status?.ToString() ?? "Never run")</span></td>
                <td>@LocalTime(shop.CompletedUtc ?? shop.StartedUtc)</td>
                <td>@LocalTime(shop.NextDueUtc)</td>
                <td><span class="table-status @(shop.IsDue ? "missing" : "ready")">@(shop.IsDue ? "Due" : "Scheduled")</span></td>
            </tr>
        }
        </tbody></table></div>
    }
</section>

@if (!AutonomousOptions.AutomaticPublishingEnabled)
{
    <div class="alert-card warning-card automation-note">
        <strong>Automatic publication is globally locked</strong>
        <span>The worker can discover, refresh, classify and prepare editorial drafts, but the application-wide publication switch is off.</span>
    </div>
}
else
{
    <div class="alert-card success-card automation-note">
        <strong>Restricted automatic mode is available</strong>
        <span>Per-shop candidate, publication, readiness, duplicate and AI-budget limits remain authoritative. The safety circuit downgrades a faulting automatic policy to Shadow without stopping deterministic catalogue work.</span>
    </div>
}

@code {
    private CatalogueAutomationOptions Options => AutomationOptions.Value;
    private int DiscoveryRequestCount => SuperstoreOptions.Shops
        .Where(shop => shop.IsEnabled)
        .Sum(shop => CatalogueDiscoveryPlanner.Build(shop, Options.PageSize).Count);
    private List<ShopScheduleRow> Shops = [];
    private List<WorkItemRow> WorkItems = [];
    private List<JobRunRow> JobRuns = [];
    private List<AutonomousCataloguePolicy> Policies = [];
    private List<AutonomousDecisionRow> RecentDecisionRows = [];
    private string? SelectedPolicySlug;
    private PolicyEditorModel? PolicyEditor;
    private AutomationQueueHealth? QueueHealth;
    private CatalogueAutomationMonitoringReport? Monitoring;
    private AutonomousPilotReport? PilotReport;
    private bool IsLoading;
    private bool IsActing;
    private bool IsBusy => IsLoading || IsActing;
    private string? ActionMessage;
    private bool ActionFailed;
    private decimal AiMonthSpend;
    private int AiCallsThisMonth;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        IsLoading = true;
        try
        {
            await using var context = await ContextFactory.CreateDbContextAsync();
            var now = TimeProvider.GetUtcNow();
            var monthStart = new DateTimeOffset(now.Year, now.Month, 1, 0, 0, 0, TimeSpan.Zero);
            var monthEnd = monthStart.AddMonths(1);
            var chargedInvocations = context.AiInvocations.AsNoTracking()
                .Where(item => item.RequestedUtc >= monthStart &&
                               item.RequestedUtc < monthEnd &&
                               item.Status != AiInvocationStatus.BudgetBlocked &&
                               item.Status != AiInvocationStatus.CacheHit);
            AiMonthSpend = await chargedInvocations.SumAsync(item =>
                item.Status == AiInvocationStatus.Reserved ? item.ReservedCostUsd : item.EstimatedCostUsd);
            AiCallsThisMonth = await chargedInvocations.CountAsync();
            var shops = await context.Shops.AsNoTracking().Where(shop => shop.IsEnabled).OrderBy(shop => shop.DisplayName).ToListAsync();
            var rows = new List<ShopScheduleRow>();
            foreach (var shop in shops)
            {
                var job = await context.IngestionJobs.AsNoTracking()
                    .Where(item => item.ShopId == shop.Id && item.Type == IngestionJobType.CatalogueDiscovery)
                    .OrderByDescending(item => item.QueuedUtc)
                    .FirstOrDefaultAsync();
                var isDue = CatalogueAutomationPlanner.IsDue(job?.Status, job?.StartedUtc, job?.CompletedUtc, now, Options);
                rows.Add(new ShopScheduleRow(
                    shop.Slug,
                    shop.DisplayName,
                    job?.Status,
                    job?.StartedUtc,
                    job?.CompletedUtc,
                    NextDue(job),
                    isDue));
            }
            Shops = rows;
            QueueHealth = await WorkQueue.GetHealthAsync();
            Monitoring = await MonitorService.GetReportAsync(Options);
            PilotReport = await PilotReportService.GetReportAsync();
            Policies = (await PolicyService.GetAllAsync()).ToList();
            SelectedPolicySlug = Policies.Any(item => item.ShopSlug == SelectedPolicySlug)
                ? SelectedPolicySlug
                : Policies.FirstOrDefault()?.ShopSlug;
            LoadPolicyEditor();
            WorkItems = await context.AutomationWorkItems.AsNoTracking()
                .OrderByDescending(item => item.QueuedUtc)
                .Take(50)
                .Select(item => new WorkItemRow(
                    item.Id,
                    item.Type,
                    item.Shop == null ? null : item.Shop.Slug,
                    item.Status,
                    item.IdempotencyKey,
                    item.AttemptCount,
                    item.MaximumAttempts,
                    item.AvailableUtc,
                    item.LeaseOwner,
                    item.LeaseExpiresUtc,
                    item.CompletedUtc,
                    item.LastError,
                    item.ResultJobId))
                .ToListAsync();
            RecentDecisionRows = await context.AutonomousCatalogueDecisions.AsNoTracking()
                .OrderByDescending(item => item.EvaluatedUtc)
                .Take(50)
                .Select(item => new AutonomousDecisionRow(
                    item.ProductId,
                    item.Product.Title,
                    item.Shop.Slug,
                    item.EditorialVersionNumber,
                    item.Mode,
                    item.Decision,
                    item.Action,
                    item.ReadinessScore,
                    item.Summary,
                    item.ReasonCodesJson,
                    item.EvaluatedUtc))
                .ToListAsync();
            JobRuns = await context.IngestionJobs.AsNoTracking()
                .Where(job => job.Type == IngestionJobType.CatalogueDiscovery ||
                              job.Type == IngestionJobType.ProductRefresh ||
                              job.Type == IngestionJobType.LinkRefresh)
                .OrderByDescending(job => job.QueuedUtc)
                .Take(50)
                .Select(job => new JobRunRow(
                    job.Id,
                    job.Type,
                    job.Shop == null ? null : job.Shop.Slug,
                    job.Status,
                    job.ItemsRead,
                    job.ItemsWritten,
                    job.ItemsRejected,
                    job.QueuedUtc,
                    job.StartedUtc,
                    job.CompletedUtc,
                    job.Checkpoint,
                    job.ErrorSummary))
                .ToListAsync();
        }
        finally { IsLoading = false; }
    }

    private void PolicySelectionChanged(ChangeEventArgs args)
    {
        SelectedPolicySlug = args.Value?.ToString();
        LoadPolicyEditor();
    }

    private void LoadPolicyEditor()
    {
        var policy = Policies.SingleOrDefault(item => item.ShopSlug == SelectedPolicySlug);
        PolicyEditor = policy is null ? null : new PolicyEditorModel(policy);
    }

    private async Task SavePolicyAsync()
    {
        if (PolicyEditor is null) return;
        IsActing = true;
        ActionFailed = false;
        try
        {
            var authentication = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var actor = authentication.User.Identity?.Name ?? "administrator";
            var result = await PolicyService.UpdateAsync(new AutonomousCataloguePolicyUpdate(
                PolicyEditor.ShopSlug,
                PolicyEditor.Mode,
                PolicyEditor.ReviewEveryHours,
                PolicyEditor.MaximumCandidatesPerRun,
                PolicyEditor.MaximumAutoPublishesPerDay,
                PolicyEditor.MinimumReadinessScore,
                PolicyEditor.DuplicateHoldConfidence,
                PolicyEditor.DailyAiBudgetUsd,
                actor,
                PolicyEditor.ExpectedRowVersion));
            ActionFailed = !result.Succeeded;
            ActionMessage = result.Message;
            if (result.Succeeded && Options.Enabled) WakeSignal.Signal();
            await LoadAsync();
        }
        catch (Exception exception)
        {
            ActionFailed = true;
            ActionMessage = exception.Message;
        }
        finally { IsActing = false; }
    }

    private async Task WakeWorkerAsync()
    {
        IsActing = true;
        ActionFailed = false;
        try
        {
            WakeSignal.Signal();
            ActionMessage = "The worker was signalled. Due SQL work will be planned and claimed in a bounded cycle.";
            await Task.Delay(250);
            await LoadAsync();
        }
        catch (Exception exception)
        {
            ActionFailed = true;
            ActionMessage = exception.Message;
        }
        finally { IsActing = false; }
    }

    private async Task RetryAsync(Guid workItemId)
    {
        IsActing = true;
        ActionFailed = false;
        try
        {
            var requeued = await WorkQueue.RequeueDeadLetterAsync(workItemId);
            ActionFailed = !requeued;
            ActionMessage = requeued
                ? "The dead-letter item was reset and queued for an immediate retry."
                : "The item is no longer in the dead-letter state.";
            if (requeued && Options.Enabled) WakeSignal.Signal();
            await LoadAsync();
        }
        catch (Exception exception)
        {
            ActionFailed = true;
            ActionMessage = exception.Message;
        }
        finally { IsActing = false; }
    }

    private DateTimeOffset? NextDue(IngestionJobRecord? job)
    {
        if (job is null) return TimeProvider.GetUtcNow();
        var activity = job.CompletedUtc ?? job.StartedUtc;
        if (activity is null) return TimeProvider.GetUtcNow();
        if (job.Status == IngestionJobStatus.Running) return activity.Value.AddHours(Options.StaleJobHours);
        return job.Status == IngestionJobStatus.Failed
            ? activity.Value.AddMinutes(Options.FailureRetryMinutes)
            : activity.Value.AddHours(Options.RefreshEveryHours);
    }

    private static string LocalTime(DateTimeOffset? value) => value is null ? "—" : value.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm");
    private static string StatusClass(IngestionJobStatus? status) => status is IngestionJobStatus.Succeeded or IngestionJobStatus.PartiallySucceeded ? "success" : status is null ? string.Empty : "failure";
    private static string WorkStatusClass(AutomationWorkStatus status) => status == AutomationWorkStatus.Succeeded ? "success" : status is AutomationWorkStatus.DeadLetter or AutomationWorkStatus.Cancelled ? "failure" : string.Empty;
    private static string ModeClass(AutonomousCatalogueMode mode) => mode == AutonomousCatalogueMode.Shadow ? "success" : mode == AutonomousCatalogueMode.Automatic ? "failure" : string.Empty;
    private static string DecisionClass(AutonomousCatalogueDecision decision) => decision == AutonomousCatalogueDecision.WouldPublish ? "success" : "failure";
    private static string DecisionLabel(AutonomousCatalogueDecision decision) => decision == AutonomousCatalogueDecision.WouldPublish ? "Would publish" : "Hold";
    private static string PilotStatusClass(AutonomousPilotReport report) => report.HasCriticalFault ? "failure" : report.HasWarning ? string.Empty : "success";
    private static string PilotStatusLabel(AutonomousPilotReport report) => report.HasCriticalFault ? "Action required" : report.HasWarning ? "Watch" : "Healthy";
    private static string PromotionAlertClass(AutonomousPilotPromotionState state) => state switch { AutonomousPilotPromotionState.ReadyForOwnerReview => "success-card", AutonomousPilotPromotionState.Blocked => "error-card", _ => "warning-card" };
    private static string PromotionLabel(AutonomousPilotPromotionState state) => state switch { AutonomousPilotPromotionState.ReadyForOwnerReview => "ready for owner review", AutonomousPilotPromotionState.Blocked => "blocked", AutonomousPilotPromotionState.Observing => "keep observing", _ => "not started" };
    private static string PilotAge(AutonomousPilotReport report) => report.FirstAutomaticEvaluationUtc is null ? "—" : (report.GeneratedUtc - report.FirstAutomaticEvaluationUtc.Value).TotalDays < 1 ? "<1 day" : $"{(int)(report.GeneratedUtc - report.FirstAutomaticEvaluationUtc.Value).TotalDays} days";
    private static string ShortError(string error) => error.Length <= 100 ? error : error[..100] + "…";
    private static string AlertClass(AutomationAlertSeverity severity) => severity switch { AutomationAlertSeverity.Critical => "error-card", AutomationAlertSeverity.Warning => "warning-card", _ => "success-card" };
    private static string Duration(DateTimeOffset? startedUtc, DateTimeOffset? completedUtc) => startedUtc is null ? "—" : completedUtc is null ? "Running" : (completedUtc.Value - startedUtc.Value).TotalSeconds < 60 ? $"{(completedUtc.Value - startedUtc.Value).TotalSeconds:N0} sec" : $"{(completedUtc.Value - startedUtc.Value).TotalMinutes:N1} min";
    private sealed record ShopScheduleRow(string Slug, string DisplayName, IngestionJobStatus? Status, DateTimeOffset? StartedUtc, DateTimeOffset? CompletedUtc, DateTimeOffset? NextDueUtc, bool IsDue);
    private sealed record WorkItemRow(Guid Id, AutomationWorkType Type, string? ShopSlug, AutomationWorkStatus Status, string IdempotencyKey, int AttemptCount, int MaximumAttempts, DateTimeOffset AvailableUtc, string? LeaseOwner, DateTimeOffset? LeaseExpiresUtc, DateTimeOffset? CompletedUtc, string? LastError, Guid? ResultJobId);
    private sealed record JobRunRow(Guid Id, IngestionJobType Type, string? ShopSlug, IngestionJobStatus Status, int ItemsRead, int ItemsWritten, int ItemsRejected, DateTimeOffset QueuedUtc, DateTimeOffset? StartedUtc, DateTimeOffset? CompletedUtc, string? Checkpoint, string? ErrorSummary);
    private sealed record AutonomousDecisionRow(string ProductId, string ProductTitle, string ShopSlug, int EditorialVersionNumber, AutonomousCatalogueMode Mode, AutonomousCatalogueDecision Decision, AutonomousCatalogueAction Action, decimal ReadinessScore, string Summary, string ReasonCodesJson, DateTimeOffset EvaluatedUtc)
    {
        public string ReasonCodes
        {
            get
            {
                try { return string.Join(", ", System.Text.Json.JsonSerializer.Deserialize<string[]>(ReasonCodesJson) ?? []); }
                catch (System.Text.Json.JsonException) { return ReasonCodesJson; }
            }
        }
    }

    private sealed class PolicyEditorModel(AutonomousCataloguePolicy policy)
    {
        public string ShopSlug { get; } = policy.ShopSlug;
        public AutonomousCatalogueMode Mode { get; set; } = policy.Mode;
        public int ReviewEveryHours { get; set; } = policy.ReviewEveryHours;
        public int MaximumCandidatesPerRun { get; set; } = policy.MaximumCandidatesPerRun;
        public int MaximumAutoPublishesPerDay { get; set; } = policy.MaximumAutoPublishesPerDay;
        public decimal MinimumReadinessScore { get; set; } = policy.MinimumReadinessScore;
        public decimal DuplicateHoldConfidence { get; set; } = policy.DuplicateHoldConfidence;
        public decimal DailyAiBudgetUsd { get; set; } = policy.DailyAiBudgetUsd;
        public DateTimeOffset UpdatedUtc { get; } = policy.UpdatedUtc;
        public string UpdatedBy { get; } = policy.UpdatedBy;
        public bool IsAutomaticallyPaused { get; } = AutonomousCatalogueSafetyService.IsAutomaticSafetyPause(policy);
        public string AutomaticPauseReason { get; } = policy.UpdatedBy.StartsWith("automatic safety:", StringComparison.OrdinalIgnoreCase)
            ? policy.UpdatedBy["automatic safety:".Length..].Trim()
            : string.Empty;
        public string ExpectedRowVersion { get; } = policy.ExpectedRowVersion;
    }
}
