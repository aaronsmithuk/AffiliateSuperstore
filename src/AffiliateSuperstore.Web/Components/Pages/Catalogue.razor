@page "/admin/catalogue"
@layout AdminLayout
@rendermode InteractiveServer
@inject CatalogueIngestionService IngestionService
@inject CatalogueDiscoveryPlanService DiscoveryPlanService
@inject CatalogueReadinessService ReadinessService
@inject ProductQualityAssessmentService QualityAssessmentService
@inject CatalogueEditorialService EditorialService
@inject IDbContextFactory<AffiliateSuperstoreDbContext> ContextFactory
@inject IOptions<CatalogueAutomationOptions> AutomationOptions
@inject AffiliateSuperstoreOptions SuperstoreOptions

<PageTitle>Catalogue operations</PageTitle>

<header class="admin-topbar">
    <div>
        <p class="eyebrow">Catalogue</p>
        <h1>Product ingestion</h1>
        <p class="lede">Discover, snapshot and link products for the configured plushies shop.</p>
    </div>
    <div class="topbar-actions"><button class="button" type="button" @onclick="RunDiscoveryPlanAsync" disabled="@IsBusy">@(IsRunningPlan ? "Expanding…" : $"Run full discovery plan ({ConfiguredRequestCount})")</button><button class="button refresh-button" type="button" @onclick="ReassessAsync" disabled="@IsBusy">@(IsAssessing ? "Checking…" : "Run quality checks")</button><a class="public-site-link" href="/plushies">View shop shell <span aria-hidden="true">↗</span></a></div>
</header>

@if (PlanResult is not null)
{
    <div class="alert-card @(PlanResult.Status == IngestionJobStatus.Failed ? "error-card" : "success-card") quality-result" role="status"><strong>Discovery plan @PlanResult.Status.ToString().ToLowerInvariant()</strong><span>@PlanResult.RequestsCompleted of @PlanResult.RequestsPlanned requests completed · @PlanResult.ProductsRead read · @PlanResult.ProductsWritten written · @PlanResult.LinksCreatedOrRefreshed links. @PlanResult.Error</span></div>
}
@if (Reassessment is not null)
{
    <div class="alert-card success-card quality-result"><strong>Quality checks complete</strong><span>@Reassessment.ProductsChecked products checked · @Reassessment.ProductsFlagged flagged · @Reassessment.ProductsDemoted previously approved products returned to review.</span></div>
}
@if (CommandResult is not null)
{
    <div class="alert-card @(CommandResult.Succeeded ? "success-card" : "error-card") quality-result" role="status"><strong>@(CommandResult.Succeeded ? "Catalogue updated" : "Update blocked")</strong><span>@CommandResult.Message</span></div>
}

@if (Readiness is not null)
{
    <section class="database-hero @(Readiness.ShopIsIndexable ? "healthy" : "unhealthy")">
        <div>
            <p class="eyebrow">Publication readiness</p>
            <h2>@(Readiness.ShopIsIndexable ? "Catalogue depth target reached" : $"{Readiness.ProductsNeededForIndexing} more indexable products needed")</h2>
            <p>Products count only when approved, quality-clear, linked, freshly checked and supplied with original editorial content. Search indexing remains separately controlled by configuration.</p>
        </div>
        <span class="database-health">@Readiness.IndexableProducts / @Readiness.IndexingTarget indexable</span>
    </section>

    <section class="metric-grid" aria-label="Catalogue readiness totals">
        <article class="metric-card"><strong>@Readiness.ActiveProducts</strong><span>Active products</span></article>
        <article class="metric-card"><strong>@Readiness.QualityClearProducts</strong><span>Quality-clear</span></article>
        <article class="metric-card"><strong>@Readiness.FlaggedProducts</strong><span>Flagged</span></article>
        <article class="metric-card"><strong>@Readiness.ApprovedProducts</strong><span>Approved</span></article>
        <article class="metric-card"><strong>@Readiness.EditoriallyCompleteProducts</strong><span>Editorially complete</span></article>
        <article class="metric-card"><strong>@Readiness.ProductsWithActiveLinks</strong><span>Active links</span></article>
        <article class="metric-card"><strong>@Readiness.PendingProducts</strong><span>Pending review</span></article>
        <article class="metric-card"><strong>@Readiness.StaleProducts</strong><span>Stale products</span></article>
    </section>
}

<div class="catalogue-grid">
    <section class="panel catalogue-runner">
        <div class="panel-heading"><div><p class="eyebrow">Manual job</p><h2>Discover products</h2></div><span class="method-badge">LIVE</span></div>
        <EditForm Model="Model" OnValidSubmit="RunAsync" FormName="catalogue-ingestion">
            <DataAnnotationsValidator />
            <div class="form-field"><label for="shop">Shop</label><InputText id="shop" @bind-Value="Model.ShopSlug" disabled /></div>
            <div class="form-field"><label for="ingest-keywords">Search keywords</label><InputText id="ingest-keywords" @bind-Value="Model.Keywords" /></div>
            <div class="form-row">
                <div class="form-field"><label for="ingest-page">Page</label><InputNumber id="ingest-page" @bind-Value="Model.PageNumber" /></div>
                <div class="form-field"><label for="ingest-size">Results</label><InputNumber id="ingest-size" @bind-Value="Model.PageSize" /></div>
            </div>
            <div class="alert-card warning-card"><strong>This performs real work</strong><span>It calls AliExpress, stores product snapshots and generates tracked links using the shop Tracking ID.</span></div>
            <button class="button button-primary run-button" type="submit" disabled="@IsBusy">
                @if (IsRunning) { <span class="spinner"></span><span>Running ingestion…</span> }
                else { <span>Run catalogue job</span><span>→</span> }
            </button>
        </EditForm>
    </section>

    <section class="panel catalogue-result">
        <div class="panel-heading"><div><p class="eyebrow">Latest run</p><h2>Job result</h2></div>@if (LastResult is not null) { <span class="result-badge @(LastResult.Status == IngestionJobStatus.Failed ? "failure" : "success")">@LastResult.Status</span> }</div>
        @if (LastResult is null)
        {
            <div class="empty-response compact"><h3>No catalogue job recorded</h3><p>Run the first product discovery job when ready.</p></div>
        }
        else
        {
            <div class="job-metrics">
                <div><strong>@LastResult.ProductsRead</strong><span>Read</span></div>
                <div><strong>@LastResult.ProductsWritten</strong><span>Written</span></div>
                <div><strong>@LastResult.ProductsRejected</strong><span>Rejected</span></div>
                <div><strong>@LastResult.LinksCreatedOrRefreshed</strong><span>Links</span></div>
            </div>
            @if (!string.IsNullOrWhiteSpace(LastResult.Error)) { <div class="alert-card error-card"><strong>Job failed</strong><span>@LastResult.Error</span></div> }
            <p class="job-id">Job @LastResult.JobId</p>
        }
    </section>
</div>

@if (Editor is not null)
{
    <section class="panel editorial-panel" id="catalogue-editor" role="dialog" aria-labelledby="catalogue-editor-title">
        <div class="panel-heading">
            <div><p class="eyebrow">Editorial</p><h2 id="catalogue-editor-title">Curate product</h2></div>
            <button class="editor-close" type="button" aria-label="Close editor" @onclick="CancelEditing">×</button>
        </div>
        <EditForm Model="Editor" OnValidSubmit="SaveEditorialAsync" FormName="catalogue-editor">
            <DataAnnotationsValidator />
            <div class="editor-source">
                @if (!string.IsNullOrWhiteSpace(Editor.ImageUrl)) { <img src="@Editor.ImageUrl" alt="" referrerpolicy="no-referrer" /> }
                <div><span>AliExpress source title</span><strong>@Editor.SourceTitle</strong><small>Product @Editor.ProductId</small></div>
            </div>
            <div class="editor-fields">
                <div class="form-field editor-title"><label for="editor-title">Public title</label><input id="editor-title" @bind="Editor.EditorialTitle" @bind:event="oninput" maxlength="@CatalogueEditorialService.MaximumTitleLength" placeholder="Leave blank to use the source title" /><ValidationMessage For="() => Editor.EditorialTitle" /><small>@(Editor.EditorialTitle?.Length ?? 0) / @CatalogueEditorialService.MaximumTitleLength characters</small></div>
                <div class="form-field editor-description"><label for="editor-description">Public description</label><textarea id="editor-description" @bind="Editor.EditorialDescription" @bind:event="oninput" maxlength="@CatalogueEditorialService.MaximumDescriptionLength" rows="5" placeholder="Add a useful, original description for shoppers and search engines"></textarea><ValidationMessage For="() => Editor.EditorialDescription" /><small>@(Editor.EditorialDescription?.Length ?? 0) / @CatalogueEditorialService.MaximumDescriptionLength characters</small></div>
                <div class="form-field"><label for="editor-order">Display order</label><input id="editor-order" type="number" min="0" max="@CatalogueEditorialService.MaximumDisplayOrder" @bind="Editor.DisplayOrder" @bind:event="oninput" /><ValidationMessage For="() => Editor.DisplayOrder" /></div>
                <label class="check-field editor-featured"><InputCheckbox @bind-Value="Editor.IsFeatured" /> Feature this product ahead of the standard catalogue order</label>
            </div>
            <div class="editor-actions"><button class="button" type="button" @onclick="CancelEditing">Cancel</button><button class="button button-primary" type="submit" disabled="@IsSaving">@(IsSaving ? "Saving…" : "Save editorial changes")</button></div>
        </EditForm>
    </section>
}

<section class="panel catalogue-table-panel">
    <div class="panel-heading catalogue-table-heading">
        <div><p class="eyebrow">Local catalogue</p><h2>Review queue</h2></div>
        <div class="catalogue-filters">
            <label>Review <select @bind="ReviewFilter"><option value="All">All</option>@foreach (var status in Enum.GetValues<ProductReviewStatus>()) { <option value="@status">@status</option> }</select></label>
            <label class="flag-filter"><input type="checkbox" @bind="FlaggedOnly" /> Flagged only</label>
            <label class="flag-filter"><input type="checkbox" @bind="ReadyToReviewOnly" /> Clear candidates</label>
            <span class="count-badge">@DisplayedProducts.Count / @Products.Count</span>
        </div>
    </div>
    @if (Products.Count == 0)
    {
        <p class="database-empty">No products have been ingested yet.</p>
    }
    else
    {
        <div class="table-scroll"><table class="admin-table catalogue-review-table"><thead><tr><th>Product</th><th>Price</th><th>Commission</th><th>Volume</th><th>Quality</th><th>Review</th><th>Link</th><th>Actions</th></tr></thead><tbody>
        @foreach (var product in DisplayedProducts)
        {
            <tr>
                <td><div class="catalogue-product-cell">@if (!string.IsNullOrWhiteSpace(product.ImageUrl)) { <img src="@product.ImageUrl" alt="" loading="lazy" referrerpolicy="no-referrer" /> }<div><strong title="@product.DisplayTitle">@product.DisplayTitle</strong><small>@product.ProductId · @product.RefreshedUtc.ToLocalTime().ToString("dd MMM HH:mm")</small>@if (product.IsFeatured) { <span class="editorial-chip">Featured · @product.DisplayOrder</span> } else if (product.HasEditorialContent) { <span class="editorial-chip">Edited</span> }</div></div></td>
                <td>@Money(product.SalePrice, product.Currency)</td><td>@Percent(product.CommissionRate)</td><td>@product.Volume?.ToString("N0")</td>
                <td>@if (product.Flags.Count == 0) { <span class="quality-clear">Clear</span> } else { <details class="quality-flags"><summary>@product.Flags.Count flag@(product.Flags.Count == 1 ? "" : "s")</summary><ul>@foreach (var flag in product.Flags) { <li><strong>@flag.Code</strong>@flag.Message</li> }</ul></details> }</td>
                <td><span class="review-status @product.ReviewStatus.ToString().ToLowerInvariant()">@product.ReviewStatus</span></td>
                <td><span class="table-status @(product.HasActiveLink ? "ready" : "missing")">@(product.HasActiveLink ? "Ready" : "Missing")</span></td>
                <td><div class="review-actions"><button aria-label="Edit @product.DisplayTitle" title="Edit public content and ordering" @onclick="() => StartEditing(product)">✎</button><button aria-label="Approve @product.DisplayTitle for the public shop" title="@(product.CanApprove ? "Approve for the public shop" : "Approval requires clear quality checks and a working link")" disabled="@(!product.CanApprove)" @onclick="() => SetReviewAsync(product.ProductId, ProductReviewStatus.Approved)">✓</button><button aria-label="Mark @product.DisplayTitle as needing review" title="Keep for manual review" @onclick="() => SetReviewAsync(product.ProductId, ProductReviewStatus.NeedsReview)">?</button><button aria-label="Reject @product.DisplayTitle from this shop" title="Reject from this shop" @onclick="() => SetReviewAsync(product.ProductId, ProductReviewStatus.Rejected)">×</button></div></td>
            </tr>
        }
        </tbody></table></div>
    }
</section>

@code {
    private readonly IngestionForm Model = new();
    private CatalogueIngestionResult? LastResult;
    private CatalogueDiscoveryPlanResult? PlanResult;
    private CatalogueReadinessReport? Readiness;
    private ProductReassessmentResult? Reassessment;
    private List<ProductRow> Products = [];
    private bool IsRunning;
    private bool IsRunningPlan;
    private bool IsAssessing;
    private bool IsSaving;
    private string ReviewFilter = "All";
    private bool FlaggedOnly;
    private bool ReadyToReviewOnly;
    private EditorialForm? Editor;
    private CatalogueCommandResult? CommandResult;

    private bool IsBusy => IsRunning || IsRunningPlan || IsAssessing || IsSaving;
    private CatalogueAutomationOptions Options => AutomationOptions.Value;
    private ShopDefinition ConfiguredShop => SuperstoreOptions.Shops.Single(shop => string.Equals(shop.Slug, "plushies", StringComparison.OrdinalIgnoreCase));
    private int ConfiguredRequestCount => CatalogueDiscoveryPlanner.Build(ConfiguredShop, Options.PageSize).Count;

    private IReadOnlyList<ProductRow> DisplayedProducts => Products
        .Where(product => ReviewFilter == "All" || string.Equals(product.ReviewStatus.ToString(), ReviewFilter, StringComparison.Ordinal))
        .Where(product => !FlaggedOnly || product.Flags.Count > 0)
        .Where(product => !ReadyToReviewOnly || product.IsClearReviewCandidate)
        .OrderByDescending(product => product.IsClearReviewCandidate)
        .ThenByDescending(product => product.Volume)
        .ToArray();

    protected override Task OnInitializedAsync() => LoadProductsAsync();

    private async Task RunAsync()
    {
        IsRunning = true;
        try
        {
            LastResult = await IngestionService.RunAsync(new CatalogueIngestionRequest(Model.ShopSlug, Model.Keywords, Model.PageNumber, Model.PageSize));
            await LoadProductsAsync();
        }
        finally { IsRunning = false; }
    }

    private async Task RunDiscoveryPlanAsync()
    {
        IsRunningPlan = true;
        try
        {
            PlanResult = await DiscoveryPlanService.RunAsync("plushies", Options.PageSize);
            LastResult = PlanResult.Runs.LastOrDefault();
            await LoadProductsAsync();
        }
        finally { IsRunningPlan = false; }
    }

    private async Task LoadProductsAsync()
    {
        await using var context = await ContextFactory.CreateDbContextAsync();
        if (LastResult is null)
        {
            var latestJob = await context.IngestionJobs.AsNoTracking()
                .Where(job => job.Type == IngestionJobType.CatalogueDiscovery)
                .OrderByDescending(job => job.QueuedUtc)
                .FirstOrDefaultAsync();
            if (latestJob is not null)
            {
                LastResult = new CatalogueIngestionResult(
                    latestJob.Id,
                    latestJob.Status,
                    latestJob.ItemsRead,
                    latestJob.ItemsWritten,
                    latestJob.ItemsRejected,
                    latestJob.LinksCreatedOrRefreshed,
                    latestJob.ErrorSummary);
            }
        }

        Products = await context.ShopProducts.AsNoTracking()
            .Where(item => item.Shop.Slug == "plushies" && item.IsActive)
            .OrderByDescending(item => item.Product.LastRefreshedUtc)
            .Take(500)
            .Select(item => new ProductRow(
                item.ProductId,
                item.Product.Title,
                item.EditorialTitle,
                item.EditorialDescription,
                item.Product.MainImageUrl,
                item.Product.LastRefreshedUtc,
                item.Product.Snapshots.OrderByDescending(snapshot => snapshot.FetchedUtc).Select(snapshot => snapshot.SalePrice).FirstOrDefault(),
                item.Product.Snapshots.OrderByDescending(snapshot => snapshot.FetchedUtc).Select(snapshot => snapshot.Currency).FirstOrDefault(),
                item.Product.Snapshots.OrderByDescending(snapshot => snapshot.FetchedUtc).Select(snapshot => snapshot.CommissionRate).FirstOrDefault(),
                item.Product.Snapshots.OrderByDescending(snapshot => snapshot.FetchedUtc).Select(snapshot => snapshot.RecentSalesVolume).FirstOrDefault(),
                item.ReviewStatus,
                item.AutomatedReviewFlags,
                item.IsFeatured,
                item.DisplayOrder,
                item.Product.AffiliateLinks.Any(link => link.ShopId == item.ShopId && link.Status == AffiliateLinkStatus.Active)))
            .ToListAsync();
        Readiness = await ReadinessService.GetAsync("plushies");
    }

    private async Task ReassessAsync()
    {
        IsAssessing = true;
        try
        {
            Reassessment = await QualityAssessmentService.ReassessShopAsync("plushies");
            await LoadProductsAsync();
        }
        finally { IsAssessing = false; }
    }

    private async Task SetReviewAsync(string productId, ProductReviewStatus status)
    {
        CommandResult = await EditorialService.SetReviewStatusAsync("plushies", productId, status);
        await LoadProductsAsync();
    }

    private void StartEditing(ProductRow product)
    {
        CommandResult = null;
        Editor = new EditorialForm
        {
            ProductId = product.ProductId,
            SourceTitle = product.SourceTitle,
            EditorialTitle = product.EditorialTitle,
            EditorialDescription = product.EditorialDescription,
            ImageUrl = product.ImageUrl,
            IsFeatured = product.IsFeatured,
            DisplayOrder = product.DisplayOrder
        };
    }

    private void CancelEditing() => Editor = null;

    private async Task SaveEditorialAsync()
    {
        if (Editor is null) return;
        IsSaving = true;
        try
        {
            CommandResult = await EditorialService.SaveAsync(new CatalogueEditorialUpdate(
                "plushies",
                Editor.ProductId,
                Editor.EditorialTitle,
                Editor.EditorialDescription,
                Editor.IsFeatured,
                Editor.DisplayOrder));
            if (CommandResult.Succeeded) Editor = null;
            await LoadProductsAsync();
        }
        finally { IsSaving = false; }
    }

    private static string Money(decimal? value, string? currency) => value is null ? "—" : $"{currency ?? "GBP"} {value:N2}";
    private static string Percent(decimal? value) => value is null ? "—" : $"{value:P1}";

    private sealed class IngestionForm
    {
        [Required] public string ShopSlug { get; set; } = "plushies";
        [Required] public string Keywords { get; set; } = "plush toy";
        [Range(1, 100)] public int PageNumber { get; set; } = 1;
        [Range(1, 50)] public int PageSize { get; set; } = 20;
    }

    private sealed class EditorialForm
    {
        public string ProductId { get; set; } = string.Empty;
        public string SourceTitle { get; set; } = string.Empty;
        public string? ImageUrl { get; set; }
        [StringLength(CatalogueEditorialService.MaximumTitleLength)] public string? EditorialTitle { get; set; }
        [StringLength(CatalogueEditorialService.MaximumDescriptionLength)] public string? EditorialDescription { get; set; }
        public bool IsFeatured { get; set; }
        [Range(0, CatalogueEditorialService.MaximumDisplayOrder)] public int DisplayOrder { get; set; }
    }

    private sealed record ProductRow(
        string ProductId,
        string SourceTitle,
        string? EditorialTitle,
        string? EditorialDescription,
        string? ImageUrl,
        DateTimeOffset RefreshedUtc,
        decimal? SalePrice,
        string? Currency,
        decimal? CommissionRate,
        long? Volume,
        ProductReviewStatus ReviewStatus,
        string? SerializedFlags,
        bool IsFeatured,
        int DisplayOrder,
        bool HasActiveLink)
    {
        public IReadOnlyList<ProductQualityFlag> Flags => ProductQualityAssessmentService.ReadFlags(SerializedFlags);
        public string DisplayTitle => EditorialTitle ?? SourceTitle;
        public bool HasEditorialContent => !string.IsNullOrWhiteSpace(EditorialTitle) || !string.IsNullOrWhiteSpace(EditorialDescription);
        public bool CanApprove => Flags.Count == 0 && HasActiveLink;
        public bool IsClearReviewCandidate => Flags.Count == 0 && HasActiveLink && ReviewStatus is ProductReviewStatus.Pending or ProductReviewStatus.NeedsReview;
    }
}
