@page "/admin/catalogue"
@layout AdminLayout
@attribute [Authorize(Policy = AdminAuthorization.PolicyName)]
@rendermode InteractiveServer
@inject CatalogueIngestionService IngestionService
@inject CatalogueDiscoveryPlanService DiscoveryPlanService
@inject CatalogueProductEnrichmentService ProductEnrichmentService
@inject CatalogueReadinessService ReadinessService
@inject ProductQualityAssessmentService QualityAssessmentService
@inject CatalogueEditorialService EditorialService
@inject CatalogueAiSuggestionService AiSuggestionService
@inject CatalogueAiQueuePreparationService AiQueuePreparationService
@inject IStructuredSuggestionProvider AiSuggestionProvider
@inject IDbContextFactory<AffiliateSuperstoreDbContext> ContextFactory
@inject IOptions<CatalogueAutomationOptions> AutomationOptions
@inject AffiliateSuperstoreOptions SuperstoreOptions
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Catalogue operations</PageTitle>

<header class="admin-topbar">
    <div>
        <p class="eyebrow">Catalogue</p>
        <h1>Product ingestion</h1>
        <p class="lede">Discover, snapshot and link products for the configured plushies shop.</p>
    </div>
    <div class="topbar-actions">
        <button class="button" type="button" @onclick="RunDiscoveryPlanAsync" disabled="@IsBusy">@(IsRunningPlan ? "Expanding…" : $"Run full discovery plan ({ConfiguredRequestCount})")</button>
        <button class="button refresh-button" type="button" @onclick="RefreshDetailsAsync" disabled="@IsBusy">@(IsEnriching ? "Refreshing details…" : "Refresh product details")</button>
        <button class="button refresh-button" type="button" @onclick="ReassessAsync" disabled="@IsBusy">@(IsAssessing ? "Checking…" : "Run quality checks")</button>
        <button class="button refresh-button" type="button" title="@AiSuggestionProvider.AvailabilityMessage" @onclick="RunAiShadowAsync" disabled="@(!AiSuggestionProvider.IsAvailable || IsBusy)">@(IsRunningAiShadow ? "Running AI sample…" : $"AI shadow sample ({CatalogueAiSuggestionService.MaximumShadowSampleSize})")</button>
        <button class="button button-primary" type="button" title="Prepare validated copy as review drafts; never approves or publishes" @onclick="PrepareAiQueueAsync" disabled="@(!AiSuggestionProvider.IsAvailable || IsBusy)">@(IsPreparingAiQueue ? "Preparing AI drafts…" : $"Prepare AI review drafts ({CatalogueAiQueuePreparationService.MaximumBatchSize})")</button>
        <a class="public-site-link" href="/plushies">View shop shell <span aria-hidden="true">↗</span></a>
    </div>
</header>

@if (PlanResult is not null)
{
    <div class="alert-card @(PlanResult.Status == IngestionJobStatus.Failed ? "error-card" : "success-card") quality-result" role="status"><strong>Discovery plan @PlanResult.Status.ToString().ToLowerInvariant()</strong><span>@PlanResult.RequestsCompleted of @PlanResult.RequestsPlanned requests completed · @PlanResult.ProductsRead read · @PlanResult.ProductsWritten written · @PlanResult.LinksCreatedOrRefreshed links. @PlanResult.Error</span></div>
}
@if (Reassessment is not null)
{
    <div class="alert-card success-card quality-result"><strong>Quality checks complete</strong><span>@Reassessment.ProductsChecked products checked · @Reassessment.ProductsFlagged flagged · @Reassessment.ProductsDemoted previously approved products returned to review.</span></div>
}
@if (EnrichmentResult is not null)
{
    <div class="alert-card @(EnrichmentResult.Status == IngestionJobStatus.Failed ? "error-card" : "success-card") quality-result" role="status"><strong>Product details @EnrichmentResult.Status.ToString().ToLowerInvariant()</strong><span>@EnrichmentResult.ProductsEnriched of @EnrichmentResult.ProductsSelected checked · @EnrichmentResult.ProductsChanged changed · @EnrichmentResult.MediaItemsStored media stored · @EnrichmentResult.ProductsSuspectedUnavailable suspected unavailable · @EnrichmentResult.ProductsConfirmedUnavailable confirmed unavailable · @EnrichmentResult.ProductsRestored restored. @EnrichmentResult.Error</span></div>
}
@if (CommandResult is not null)
{
    <div class="alert-card @(CommandResult.Succeeded ? "success-card" : "error-card") quality-result" role="status">
        <strong>@(CommandResult.Succeeded ? "Catalogue updated" : "Update blocked")</strong><span>@CommandResult.Message</span>
        @if (CommandResult.Findings?.Count > 0)
        {
            <ul class="validation-findings">@foreach (var finding in CommandResult.Findings) { <li><strong>@finding.Field:</strong> @finding.Message @if (!string.IsNullOrWhiteSpace(finding.Evidence)) { <code>@finding.Evidence</code> }</li> }</ul>
        }
    </div>
}

@if (AiShadowRun is not null)
{
    <section class="panel catalogue-table-panel" aria-labelledby="ai-shadow-title">
        <div class="panel-heading catalogue-table-heading">
            <div><p class="eyebrow">Review only</p><h2 id="ai-shadow-title">AI shadow sample</h2></div>
            <span class="method-badge">NO AUTO-SAVE</span>
        </div>
        <div class="alert-card warning-card quality-result" role="status">
            <strong>@AiShadowRun.CompletedCount of @AiShadowRun.SelectedCount suggestions checked</strong>
            <span>@AiShadowRun.SucceededCount reviewable · @AiShadowRun.BlockedCount blocked · @AiShadowRun.FailedCount failed · @AiShadowRun.CacheHitCount cached · @AiShadowRun.InputTokens input tokens · @AiShadowRun.OutputTokens output tokens · estimated USD @AiShadowRun.EstimatedCostUsd.ToString("F6"). @AiShadowRun.Message</span>
        </div>
        @if (AiShadowRun.Items.Count > 0)
        {
            <div class="table-scroll"><table class="admin-table"><thead><tr><th>Source product</th><th>Result</th><th>Suggested copy</th><th>Evidence</th><th>Cost</th></tr></thead><tbody>
            @foreach (var item in AiShadowRun.Items)
            {
                <tr>
                    <td><strong>@item.SourceTitle</strong><small>@item.ProductId · @item.ReviewStatus</small></td>
                    <td><span class="validation-state @(item.Result.Succeeded ? "warning" : "blocked")">@(item.Result.Succeeded ? "Review" : item.Result.IsBlocked ? "Blocked" : "Failed")</span><small>@item.Result.Message</small></td>
                    <td>@if (item.Result.Suggestion is not null) { <strong>@item.Result.Suggestion.SuggestedTitle</strong><p>@item.Result.Suggestion.SuggestedDescription</p> } else { <span>—</span> }</td>
                    <td>@if (item.Result.Findings?.Count > 0) { <ul class="validation-findings">@foreach (var finding in item.Result.Findings) { <li>@finding.Message</li> }</ul> } else { <span>Clear</span> }</td>
                    <td>USD @item.EstimatedCostUsd.ToString("F6")@if (item.Result.Suggestion?.WasCached == true) { <small>Cached</small> }</td>
                </tr>
            }
            </tbody></table></div>
        }
    </section>
}

@if (AiQueueResult is not null)
{
    <section class="panel catalogue-table-panel" aria-labelledby="ai-queue-title">
        <div class="panel-heading catalogue-table-heading">
            <div><p class="eyebrow">Approval queue</p><h2 id="ai-queue-title">AI-prepared review drafts</h2></div>
            <span class="method-badge">HUMAN APPROVAL REQUIRED</span>
        </div>
        <div class="alert-card @(AiQueueResult.DraftsSaved > 0 ? "success-card" : "warning-card") quality-result" role="status">
            <strong>@AiQueueResult.DraftsSaved of @AiQueueResult.SelectedCount drafts saved</strong>
            <span>@AiQueueResult.WarningCount warning · @AiQueueResult.BlockedCount blocked · @AiQueueResult.FailedCount failed · @AiQueueResult.CacheHitCount cached · @AiQueueResult.InputTokens input tokens · @AiQueueResult.OutputTokens output tokens · estimated USD @AiQueueResult.EstimatedCostUsd.ToString("F6"). @AiQueueResult.Message</span>
        </div>
        @if (AiQueueResult.Items.Count > 0)
        {
            <div class="table-scroll"><table class="admin-table"><thead><tr><th>Product</th><th>AI draft</th><th>Outcome</th><th>Cost</th></tr></thead><tbody>
            @foreach (var item in AiQueueResult.Items)
            {
                <tr>
                    <td><strong>@item.SourceTitle</strong><small>@item.ProductId · @item.ReviewStatus</small></td>
                    <td>@if (item.SuggestionResult.Suggestion is not null) { <strong>@item.SuggestionResult.Suggestion.SuggestedTitle</strong><p>@item.SuggestionResult.Suggestion.SuggestedDescription</p> } else { <span>—</span> }</td>
                    <td><span class="validation-state @(item.DraftSaved ? "warning" : item.SuggestionResult.IsBlocked ? "blocked" : "note")">@(item.DraftSaved ? "Review" : item.SuggestionResult.IsBlocked ? "Blocked" : "Skipped")</span><small>@item.Outcome</small></td>
                    <td>USD @item.EstimatedCostUsd.ToString("F6")@if (item.SuggestionResult.Suggestion?.WasCached == true) { <small>Cached</small> }</td>
                </tr>
            }
            </tbody></table></div>
        }
    </section>
}

@if (Readiness is not null)
{
    <section class="database-hero @(Readiness.ShopIsIndexable ? "healthy" : "unhealthy")">
        <div>
            <p class="eyebrow">Publication readiness</p>
            <h2>@(Readiness.ShopIsIndexable ? "Catalogue depth target reached" : $"{Readiness.ProductsNeededForIndexing} more indexable products needed")</h2>
            <p>Products count only when approved, quality-clear, linked, freshly checked and supplied with original editorial content. Search indexing remains separately controlled by configuration.</p>
        </div>
        <span class="database-health">@Readiness.IndexableProducts / @Readiness.IndexingTarget indexable</span>
    </section>

    <section class="metric-grid" aria-label="Catalogue readiness totals">
        <article class="metric-card"><strong>@Readiness.ActiveProducts</strong><span>Active products</span></article>
        <article class="metric-card"><strong>@Readiness.QualityClearProducts</strong><span>Quality-clear</span></article>
        <article class="metric-card"><strong>@Readiness.FlaggedProducts</strong><span>Flagged</span></article>
        <article class="metric-card"><strong>@Readiness.ApprovedProducts</strong><span>Approved</span></article>
        <article class="metric-card"><strong>@Readiness.EditoriallyCompleteProducts</strong><span>Editorially complete</span></article>
        <article class="metric-card"><strong>@Readiness.ProductsWithActiveLinks</strong><span>Active links</span></article>
        <article class="metric-card"><strong>@Readiness.PendingProducts</strong><span>Pending review</span></article>
        <article class="metric-card"><strong>@Readiness.StaleProducts</strong><span>Stale products</span></article>
        <article class="metric-card"><strong>@Readiness.AvailableProducts</strong><span>Available</span></article>
        <article class="metric-card"><strong>@Readiness.SuspectedUnavailableProducts</strong><span>Availability watch</span></article>
        <article class="metric-card"><strong>@Readiness.UnavailableProducts</strong><span>Unavailable</span></article>
    </section>
}

<div class="catalogue-grid">
    <section class="panel catalogue-runner">
        <div class="panel-heading"><div><p class="eyebrow">Manual job</p><h2>Discover products</h2></div><span class="method-badge">LIVE</span></div>
        <EditForm Model="Model" OnValidSubmit="RunAsync" FormName="catalogue-ingestion">
            <DataAnnotationsValidator />
            <div class="form-field"><label for="shop">Shop</label><InputText id="shop" @bind-Value="Model.ShopSlug" disabled /></div>
            <div class="form-field"><label for="ingest-keywords">Search keywords</label><InputText id="ingest-keywords" @bind-Value="Model.Keywords" /></div>
            <div class="form-row">
                <div class="form-field"><label for="ingest-page">Page</label><InputNumber id="ingest-page" @bind-Value="Model.PageNumber" /></div>
                <div class="form-field"><label for="ingest-size">Results</label><InputNumber id="ingest-size" @bind-Value="Model.PageSize" /></div>
            </div>
            <div class="alert-card warning-card"><strong>This performs real work</strong><span>It calls AliExpress, stores product snapshots and generates tracked links using the shop Tracking ID.</span></div>
            <button class="button button-primary run-button" type="submit" disabled="@IsBusy">
                @if (IsRunning) { <span class="spinner"></span><span>Running ingestion…</span> }
                else { <span>Run catalogue job</span><span>→</span> }
            </button>
        </EditForm>
    </section>

    <section class="panel catalogue-result">
        <div class="panel-heading"><div><p class="eyebrow">Latest run</p><h2>Job result</h2></div>@if (LastResult is not null) { <span class="result-badge @(LastResult.Status == IngestionJobStatus.Failed ? "failure" : "success")">@LastResult.Status</span> }</div>
        @if (LastResult is null)
        {
            <div class="empty-response compact"><h3>No catalogue job recorded</h3><p>Run the first product discovery job when ready.</p></div>
        }
        else
        {
            <div class="job-metrics">
                <div><strong>@LastResult.ProductsRead</strong><span>Read</span></div>
                <div><strong>@LastResult.ProductsWritten</strong><span>Written</span></div>
                <div><strong>@LastResult.ProductsRejected</strong><span>Rejected</span></div>
                <div><strong>@LastResult.LinksCreatedOrRefreshed</strong><span>Links</span></div>
            </div>
            @if (!string.IsNullOrWhiteSpace(LastResult.Error)) { <div class="alert-card error-card"><strong>Job failed</strong><span>@LastResult.Error</span></div> }
            <p class="job-id">Job @LastResult.JobId</p>
        }
    </section>
</div>

@if (Editor is not null)
{
    <section class="panel editorial-panel" id="catalogue-editor" role="dialog" aria-labelledby="catalogue-editor-title">
        <div class="panel-heading">
            <div><p class="eyebrow">Editorial</p><h2 id="catalogue-editor-title">Curate product</h2></div>
            <button class="editor-close" type="button" aria-label="Close editor" @onclick="CancelEditing">×</button>
        </div>
        <EditForm Model="Editor" OnValidSubmit="SaveEditorialAsync" FormName="catalogue-editor">
            <DataAnnotationsValidator />
            <div class="editor-source">
                @if (!string.IsNullOrWhiteSpace(Editor.ImageUrl)) { <img src="@Editor.ImageUrl" alt="" referrerpolicy="no-referrer" /> }
                <div><span>AliExpress source title</span><strong>@Editor.SourceTitle</strong><small>Product @Editor.ProductId</small></div>
            </div>
            <div class="editor-fields">
                <div class="form-field editor-title"><label for="editor-title">Public title</label><input id="editor-title" @bind="Editor.EditorialTitle" @bind:event="oninput" maxlength="@CatalogueEditorialService.MaximumTitleLength" placeholder="Leave blank to use the source title" /><ValidationMessage For="() => Editor.EditorialTitle" /><small>@(Editor.EditorialTitle?.Length ?? 0) / @CatalogueEditorialService.MaximumTitleLength characters</small></div>
                <div class="form-field editor-description"><label for="editor-description">Public description</label><textarea id="editor-description" @bind="Editor.EditorialDescription" @bind:event="oninput" maxlength="@CatalogueEditorialService.MaximumDescriptionLength" rows="5" placeholder="Add a useful, original description for shoppers and search engines"></textarea><ValidationMessage For="() => Editor.EditorialDescription" /><small>@(Editor.EditorialDescription?.Length ?? 0) / @CatalogueEditorialService.MaximumDescriptionLength characters</small></div>
                <div class="form-field editor-description"><label for="editor-verified-size">Human-verified size</label><input id="editor-verified-size" @bind="Editor.VerifiedSize" maxlength="@CatalogueEditorialService.MaximumVerifiedSizeLength" placeholder="Example: 16 cm tall for the selected pictured option" /><ValidationMessage For="() => Editor.VerifiedSize" /><small>Leave blank until the listing images and option selector agree. Machine-parsed title sizes are never published here.</small></div>
                <div class="form-field editor-description"><label for="editor-verified-options">Human-verified options</label><textarea id="editor-verified-options" @bind="Editor.VerifiedOptions" maxlength="@CatalogueEditorialService.MaximumVerifiedOptionsLength" rows="3" placeholder="Summarise only options confirmed on the live seller listing"></textarea><ValidationMessage For="() => Editor.VerifiedOptions" /></div>
                <div class="form-field editor-description"><label for="editor-verification-evidence">Verification evidence</label><textarea id="editor-verification-evidence" @bind="Editor.VerificationEvidence" maxlength="@CatalogueEditorialService.MaximumVerificationEvidenceLength" rows="3" placeholder="Record what was checked, where, and any limitation"></textarea><ValidationMessage For="() => Editor.VerificationEvidence" /><small>Required whenever a verified size or option is supplied. Saving creates an audited revision and returns an approved product to review.</small></div>
                <div class="form-field editor-description"><label for="editor-reason">Change note</label><input id="editor-reason" @bind="Editor.ChangeReason" maxlength="@CatalogueEditorialService.MaximumChangeReasonLength" placeholder="Why this revision was made (optional)" /><small>Stored with the revision for future review.</small></div>
                <div class="form-field"><label for="editor-order">Display order</label><input id="editor-order" type="number" min="0" max="@CatalogueEditorialService.MaximumDisplayOrder" @bind="Editor.DisplayOrder" @bind:event="oninput" /><ValidationMessage For="() => Editor.DisplayOrder" /></div>
                <label class="check-field editor-featured"><InputCheckbox @bind-Value="Editor.IsFeatured" /> Feature this product ahead of the standard catalogue order</label>
            </div>
            <div class="editor-actions"><button class="button" type="button" title="@AiSuggestionProvider.AvailabilityMessage" disabled="@(!AiSuggestionProvider.IsAvailable || IsSaving || IsSuggesting)" @onclick="SuggestEditorialAsync">@(IsSuggesting ? "Drafting…" : "Suggest with AI")</button><button class="button" type="button" @onclick="CancelEditing">Cancel</button><button class="button button-primary" type="submit" disabled="@(IsSaving || IsSuggesting)">@(IsSaving ? "Saving…" : "Save editorial changes")</button></div>
        </EditForm>
        @if (AiSuggestion is not null)
        {
            <div class="alert-card @(AiSuggestion.Succeeded ? "warning-card" : "error-card") quality-result" role="status">
                <strong>AI review draft</strong><span>@AiSuggestion.Message</span>
                @if (AiSuggestion.Suggestion is not null)
                {
                    <small>@AiSuggestion.Suggestion.Provider · @AiSuggestion.Suggestion.Model · prompt @CatalogueAiSuggestionService.PromptVersion</small>
                    @if (AiSuggestion.Suggestion.Uncertainties.Count > 0) { <p><strong>Uncertainties:</strong> @string.Join("; ", AiSuggestion.Suggestion.Uncertainties)</p> }
                    @if (AiSuggestion.Suggestion.RemovedNoise.Count > 0) { <p><strong>Removed noise:</strong> @string.Join("; ", AiSuggestion.Suggestion.RemovedNoise)</p> }
                }
                @if (AiSuggestion.Findings?.Count > 0) { <ul class="validation-findings">@foreach (var finding in AiSuggestion.Findings) { <li>@finding.Message</li> }</ul> }
            </div>
        }
        <section class="revision-history" aria-labelledby="revision-history-title">
            <div class="revision-heading"><div><p class="eyebrow">Audit trail</p><h3 id="revision-history-title">Editorial revisions</h3></div><span>@Editor.History.Count revision@(Editor.History.Count == 1 ? "" : "s")</span></div>
            @if (Editor.History.Count == 0)
            {
                <p class="database-empty">The first saved edit will create this product's revision history.</p>
            }
            else
            {
                <ol class="revision-list">
                    @foreach (var revision in Editor.History)
                    {
                        <li class="revision-card">
                            <div class="revision-summary"><strong>Revision @revision.VersionNumber · @revision.ChangeKind</strong><span class="validation-state @revision.ValidationState.ToString().ToLowerInvariant()">@revision.ValidationState</span></div>
                            <p>@string.Join(", ", revision.ChangedFields) · @revision.CreatedBy · @revision.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</p>
                            @if (revision.RolledBackFromVersionNumber is not null) { <p>Restored from revision @revision.RolledBackFromVersionNumber.</p> }
                            @if (!string.IsNullOrWhiteSpace(revision.ChangeReason)) { <blockquote>@revision.ChangeReason</blockquote> }
                            <details><summary>View stored content and evidence</summary><dl><dt>Title</dt><dd>@(revision.EditorialTitle ?? "Uses source title")</dd><dt>Description</dt><dd>@(revision.EditorialDescription ?? "No description")</dd><dt>Verified size</dt><dd>@(revision.VerifiedSize ?? "Not recorded")</dd><dt>Verified options</dt><dd>@(revision.VerifiedOptions ?? "Not recorded")</dd><dt>Verification evidence</dt><dd>@(revision.VerificationEvidence ?? "Not recorded")</dd></dl>@if (revision.Findings.Count > 0) { <ul class="validation-findings">@foreach (var finding in revision.Findings) { <li>@finding.Message</li> }</ul> }</details>
                            @if (revision.VersionNumber != Editor.CurrentVersionNumber)
                            {
                                <button class="button revision-restore" type="button" disabled="@IsSaving" @onclick="() => RestoreRevisionAsync(revision.Id)">Restore as new revision</button>
                            }
                        </li>
                    }
                </ol>
            }
        </section>
    </section>
}

<section class="panel catalogue-table-panel">
    <div class="panel-heading catalogue-table-heading">
        <div><p class="eyebrow">Local catalogue</p><h2>Review queue</h2></div>
        <div class="catalogue-filters">
            <label>Review <select @bind="ReviewFilter"><option value="All">All</option>@foreach (var status in Enum.GetValues<ProductReviewStatus>()) { <option value="@status">@status</option> }</select></label>
            <label>Availability <select @bind="AvailabilityFilter"><option value="All">All</option>@foreach (var status in Enum.GetValues<ProductAvailabilityState>()) { <option value="@status">@status</option> }</select></label>
            <label class="flag-filter"><input type="checkbox" @bind="FlaggedOnly" /> Flagged only</label>
            <label class="flag-filter"><input type="checkbox" @bind="ReadyToReviewOnly" /> Clear candidates</label>
            <span class="count-badge">@DisplayedProducts.Count / @Products.Count</span>
        </div>
    </div>
    @if (Products.Count == 0)
    {
        <p class="database-empty">No products have been ingested yet.</p>
    }
    else
    {
        <div class="table-scroll"><table class="admin-table catalogue-review-table"><thead><tr><th>Product</th><th>Price</th><th>Commission</th><th>Volume</th><th>Details</th><th>Availability</th><th>Quality</th><th>Review</th><th>Link</th><th>Actions</th></tr></thead><tbody>
        @foreach (var product in DisplayedProducts)
        {
            <tr>
                <td><div class="catalogue-product-cell">@if (!string.IsNullOrWhiteSpace(product.ImageUrl)) { <img src="@product.ImageUrl" alt="" loading="lazy" referrerpolicy="no-referrer" /> }<div><strong title="@product.DisplayTitle">@product.DisplayTitle</strong><small>@product.ProductId · @product.RefreshedUtc.ToLocalTime().ToString("dd MMM HH:mm")</small>@if (product.HasVerifiedFacts) { <span class="editorial-chip">Facts verified</span> }@if (product.IsFeatured) { <span class="editorial-chip">Featured · @product.DisplayOrder</span> } else if (product.HasEditorialContent) { <span class="editorial-chip">Edited</span> }</div></div></td>
                <td>@Money(product.SalePrice, product.Currency)</td><td>@Percent(product.CommissionRate)</td><td>@product.Volume?.ToString("N0")</td><td>@if (product.LastDetailRefreshedUtc is null) { <span class="table-status missing">Basic only</span> } else { <span class="table-status ready">@product.MediaCount media</span><small class="table-detail-time">@product.LastDetailRefreshedUtc.Value.ToLocalTime().ToString("dd MMM HH:mm")</small> }</td>
                <td><span class="table-status @(product.AvailabilityState == ProductAvailabilityState.Available ? "ready" : "missing")">@product.AvailabilityState</span>@if (product.LastCheckedUtc is not null) { <small class="table-detail-time">Checked @product.LastCheckedUtc.Value.ToLocalTime().ToString("dd MMM HH:mm")</small> }@if (product.ConsecutiveUnavailableChecks > 0) { <small class="table-detail-time">@product.ConsecutiveUnavailableChecks direct miss@(product.ConsecutiveUnavailableChecks == 1 ? "" : "es")</small> }</td>
                <td>@if (product.Flags.Count == 0) { <span class="quality-clear">Clear</span> } else { <details class="quality-flags"><summary>@product.Flags.Count flag@(product.Flags.Count == 1 ? "" : "s")</summary><ul>@foreach (var flag in product.Flags) { <li><strong>@flag.Code</strong>@flag.Message</li> }</ul></details> }</td>
                <td><span class="review-status @product.ReviewStatus.ToString().ToLowerInvariant()">@product.ReviewStatus</span><small class="validation-state @product.EditorialValidationState.ToString().ToLowerInvariant()">Copy: @product.EditorialValidationState@if (product.CurrentEditorialVersionNumber is not null) { <text> · v@(product.CurrentEditorialVersionNumber)</text> }</small></td>
                <td><span class="table-status @(product.HasActiveLink ? "ready" : "missing")">@(product.HasActiveLink ? "Ready" : "Missing")</span></td>
                <td><div class="review-actions"><button aria-label="Edit @product.DisplayTitle" title="Edit public content and ordering" @onclick="() => StartEditingAsync(product)">✎</button><button aria-label="Approve @product.DisplayTitle for the public shop" title="@(product.CanApprove ? "Approve for the public shop" : "Approval requires clear quality checks and a working link")" disabled="@(!product.CanApprove)" @onclick="() => SetReviewAsync(product.ProductId, ProductReviewStatus.Approved)">✓</button><button aria-label="Mark @product.DisplayTitle as needing review" title="Keep for manual review" @onclick="() => SetReviewAsync(product.ProductId, ProductReviewStatus.NeedsReview)">?</button><button aria-label="Reject @product.DisplayTitle from this shop" title="Reject from this shop" @onclick="() => SetReviewAsync(product.ProductId, ProductReviewStatus.Rejected)">×</button></div></td>
            </tr>
        }
        </tbody></table></div>
    }
</section>

@code {
    private readonly IngestionForm Model = new();
    private CatalogueIngestionResult? LastResult;
    private CatalogueDiscoveryPlanResult? PlanResult;
    private CatalogueReadinessReport? Readiness;
    private ProductReassessmentResult? Reassessment;
    private CatalogueProductEnrichmentResult? EnrichmentResult;
    private List<ProductRow> Products = [];
    private bool IsRunning;
    private bool IsRunningPlan;
    private bool IsAssessing;
    private bool IsEnriching;
    private bool IsSaving;
    private bool IsSuggesting;
    private bool IsRunningAiShadow;
    private bool IsPreparingAiQueue;
    private string ReviewFilter = "All";
    private string AvailabilityFilter = "All";
    private bool FlaggedOnly;
    private bool ReadyToReviewOnly;
    private EditorialForm? Editor;
    private CatalogueCommandResult? CommandResult;

    private bool IsBusy => IsRunning || IsRunningPlan || IsEnriching || IsAssessing || IsSaving || IsSuggesting || IsRunningAiShadow || IsPreparingAiQueue;
    private CatalogueAiSuggestionResult? AiSuggestion;
    private CatalogueAiShadowRunResult? AiShadowRun;
    private CatalogueAiQueuePreparationResult? AiQueueResult;
    private CatalogueAutomationOptions Options => AutomationOptions.Value;
    private ShopDefinition ConfiguredShop => SuperstoreOptions.Shops.Single(shop => string.Equals(shop.Slug, "plushies", StringComparison.OrdinalIgnoreCase));
    private int ConfiguredRequestCount => CatalogueDiscoveryPlanner.Build(ConfiguredShop, Options.PageSize).Count;

    private IReadOnlyList<ProductRow> DisplayedProducts => Products
        .Where(product => ReviewFilter == "All" || string.Equals(product.ReviewStatus.ToString(), ReviewFilter, StringComparison.Ordinal))
        .Where(product => AvailabilityFilter == "All" || string.Equals(product.AvailabilityState.ToString(), AvailabilityFilter, StringComparison.Ordinal))
        .Where(product => !FlaggedOnly || product.Flags.Count > 0)
        .Where(product => !ReadyToReviewOnly || product.IsClearReviewCandidate)
        .OrderByDescending(product => product.IsClearReviewCandidate)
        .ThenByDescending(product => product.Volume)
        .ToArray();

    protected override Task OnInitializedAsync() => LoadProductsAsync();

    private async Task RunAsync()
    {
        IsRunning = true;
        try
        {
            LastResult = await IngestionService.RunAsync(new CatalogueIngestionRequest(Model.ShopSlug, Model.Keywords, Model.PageNumber, Model.PageSize));
            await LoadProductsAsync();
        }
        finally { IsRunning = false; }
    }

    private async Task RunDiscoveryPlanAsync()
    {
        IsRunningPlan = true;
        try
        {
            PlanResult = await DiscoveryPlanService.RunAsync("plushies", Options.PageSize);
            LastResult = PlanResult.Runs.LastOrDefault();
            await LoadProductsAsync();
        }
        finally { IsRunningPlan = false; }
    }

    private async Task LoadProductsAsync()
    {
        await using var context = await ContextFactory.CreateDbContextAsync();
        if (LastResult is null)
        {
            var latestJob = await context.IngestionJobs.AsNoTracking()
                .Where(job => job.Type == IngestionJobType.CatalogueDiscovery)
                .OrderByDescending(job => job.QueuedUtc)
                .FirstOrDefaultAsync();
            if (latestJob is not null)
            {
                LastResult = new CatalogueIngestionResult(
                    latestJob.Id,
                    latestJob.Status,
                    latestJob.ItemsRead,
                    latestJob.ItemsWritten,
                    latestJob.ItemsRejected,
                    latestJob.LinksCreatedOrRefreshed,
                    latestJob.ErrorSummary);
            }
        }

        Products = await context.ShopProducts.AsNoTracking()
            .Where(item => item.Shop.Slug == "plushies" && item.IsActive)
            .OrderByDescending(item => item.Product.LastRefreshedUtc)
            .Take(500)
            .Select(item => new ProductRow(
                item.ProductId,
                item.Product.Title,
                item.EditorialTitle,
                item.EditorialDescription,
                item.VerifiedSize,
                item.VerifiedOptions,
                item.VerificationEvidence,
                item.Product.MainImageUrl,
                item.Product.LastRefreshedUtc,
                item.Product.Snapshots.OrderByDescending(snapshot => snapshot.FetchedUtc).Select(snapshot => snapshot.SalePrice).FirstOrDefault(),
                item.Product.Snapshots.OrderByDescending(snapshot => snapshot.FetchedUtc).Select(snapshot => snapshot.Currency).FirstOrDefault(),
                item.Product.Snapshots.OrderByDescending(snapshot => snapshot.FetchedUtc).Select(snapshot => snapshot.CommissionRate).FirstOrDefault(),
                item.Product.Snapshots.OrderByDescending(snapshot => snapshot.FetchedUtc).Select(snapshot => snapshot.RecentSalesVolume).FirstOrDefault(),
                item.Product.LastDetailRefreshedUtc,
                item.Product.Media.Count,
                item.Product.AvailabilityState,
                item.Product.LastCheckedUtc,
                item.Product.ConsecutiveUnavailableChecks,
                item.ReviewStatus,
                item.AutomatedReviewFlags,
                item.IsFeatured,
                item.DisplayOrder,
                item.CurrentEditorialVersionNumber,
                item.EditorialValidationState,
                item.RowVersion,
                item.Product.AffiliateLinks.Any(link => link.ShopId == item.ShopId && link.Status == AffiliateLinkStatus.Active)))
            .ToListAsync();
        Readiness = await ReadinessService.GetAsync("plushies");
    }

    private async Task ReassessAsync()
    {
        IsAssessing = true;
        try
        {
            Reassessment = await QualityAssessmentService.ReassessShopAsync("plushies");
            await LoadProductsAsync();
        }
        finally { IsAssessing = false; }
    }

    private async Task RefreshDetailsAsync()
    {
        IsEnriching = true;
        try
        {
            EnrichmentResult = await ProductEnrichmentService.RunAsync("plushies", force: true);
            await LoadProductsAsync();
        }
        finally { IsEnriching = false; }
    }

    private async Task SetReviewAsync(string productId, ProductReviewStatus status)
    {
        CommandResult = await EditorialService.SetReviewStatusAsync("plushies", productId, status);
        await LoadProductsAsync();
    }

    private async Task StartEditingAsync(ProductRow product)
    {
        CommandResult = null;
        AiSuggestion = null;
        Editor = new EditorialForm
        {
            ProductId = product.ProductId,
            SourceTitle = product.SourceTitle,
            EditorialTitle = product.EditorialTitle,
            EditorialDescription = product.EditorialDescription,
            VerifiedSize = product.VerifiedSize,
            VerifiedOptions = product.VerifiedOptions,
            VerificationEvidence = product.VerificationEvidence,
            ImageUrl = product.ImageUrl,
            IsFeatured = product.IsFeatured,
            DisplayOrder = product.DisplayOrder,
            CurrentVersionNumber = product.CurrentEditorialVersionNumber,
            ExpectedRowVersion = Convert.ToBase64String(product.RowVersion),
            History = (await EditorialService.GetHistoryAsync("plushies", product.ProductId)).ToList()
        };
    }

    private void CancelEditing() => Editor = null;

    private async Task SuggestEditorialAsync()
    {
        if (Editor is null) return;
        IsSuggesting = true;
        try
        {
            AiSuggestion = await AiSuggestionService.SuggestAsync("plushies", Editor.ProductId);
            if (AiSuggestion.Succeeded && AiSuggestion.Suggestion is not null)
            {
                Editor.EditorialTitle = AiSuggestion.Suggestion.SuggestedTitle;
                Editor.EditorialDescription = AiSuggestion.Suggestion.SuggestedDescription;
                Editor.ChangeReason = $"AI-assisted draft ({AiSuggestion.Suggestion.Provider}/{AiSuggestion.Suggestion.Model}); reviewed by editor before save.";
            }
        }
        finally { IsSuggesting = false; }
    }

    private async Task RunAiShadowAsync()
    {
        IsRunningAiShadow = true;
        try
        {
            AiShadowRun = await AiSuggestionService.RunShadowAsync(
                "plushies",
                CatalogueAiSuggestionService.MaximumShadowSampleSize);
        }
        finally { IsRunningAiShadow = false; }
    }

    private async Task PrepareAiQueueAsync()
    {
        IsPreparingAiQueue = true;
        try
        {
            AiQueueResult = await AiQueuePreparationService.RunAsync(
                "plushies",
                CatalogueAiQueuePreparationService.MaximumBatchSize,
                await CurrentActorAsync());
            await LoadProductsAsync();
        }
        finally { IsPreparingAiQueue = false; }
    }

    private async Task SaveEditorialAsync()
    {
        if (Editor is null) return;
        IsSaving = true;
        try
        {
            var actor = await CurrentActorAsync();
            var result = await EditorialService.SaveAsync(new CatalogueEditorialUpdate(
                "plushies",
                Editor.ProductId,
                Editor.EditorialTitle,
                Editor.EditorialDescription,
                Editor.IsFeatured,
                Editor.DisplayOrder,
                Editor.ExpectedRowVersion,
                actor,
                Editor.ChangeReason,
                Editor.VerifiedSize,
                Editor.VerifiedOptions,
                Editor.VerificationEvidence));
            CommandResult = result;
            await LoadProductsAsync();
            if (result.Succeeded)
            {
                var updated = Products.Single(product => product.ProductId == Editor.ProductId);
                await StartEditingAsync(updated);
                CommandResult = new CatalogueCommandResult(true, result.Message, result.VersionId, result.Findings);
            }
        }
        finally { IsSaving = false; }
    }

    private async Task RestoreRevisionAsync(Guid versionId)
    {
        if (Editor is null) return;
        IsSaving = true;
        try
        {
            var actor = await CurrentActorAsync();
            var result = await EditorialService.RollbackAsync(
                "plushies", Editor.ProductId, versionId, actor, Editor.ChangeReason, Editor.ExpectedRowVersion);
            CommandResult = result;
            await LoadProductsAsync();
            if (result.Succeeded)
            {
                var updated = Products.Single(product => product.ProductId == Editor.ProductId);
                await StartEditingAsync(updated);
                CommandResult = new CatalogueCommandResult(true, result.Message, result.VersionId, result.Findings);
            }
        }
        finally { IsSaving = false; }
    }

    private async Task<string> CurrentActorAsync() =>
        (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.Identity?.Name ?? "administrator";

    private static string Money(decimal? value, string? currency) => value is null ? "—" : $"{currency ?? "GBP"} {value:N2}";
    private static string Percent(decimal? value) => value is null ? "—" : $"{value:P1}";

    private sealed class IngestionForm
    {
        [Required] public string ShopSlug { get; set; } = "plushies";
        [Required] public string Keywords { get; set; } = "plush toy";
        [Range(1, 100)] public int PageNumber { get; set; } = 1;
        [Range(1, 50)] public int PageSize { get; set; } = 20;
    }

    private sealed class EditorialForm
    {
        public string ProductId { get; set; } = string.Empty;
        public string SourceTitle { get; set; } = string.Empty;
        public string? ImageUrl { get; set; }
        [StringLength(CatalogueEditorialService.MaximumTitleLength)] public string? EditorialTitle { get; set; }
        [StringLength(CatalogueEditorialService.MaximumDescriptionLength)] public string? EditorialDescription { get; set; }
        [StringLength(CatalogueEditorialService.MaximumVerifiedSizeLength)] public string? VerifiedSize { get; set; }
        [StringLength(CatalogueEditorialService.MaximumVerifiedOptionsLength)] public string? VerifiedOptions { get; set; }
        [StringLength(CatalogueEditorialService.MaximumVerificationEvidenceLength)] public string? VerificationEvidence { get; set; }
        public bool IsFeatured { get; set; }
        [Range(0, CatalogueEditorialService.MaximumDisplayOrder)] public int DisplayOrder { get; set; }
        [StringLength(CatalogueEditorialService.MaximumChangeReasonLength)] public string? ChangeReason { get; set; }
        public int? CurrentVersionNumber { get; set; }
        public string? ExpectedRowVersion { get; set; }
        public List<EditorialVersionHistoryEntry> History { get; set; } = [];
    }

    private sealed record ProductRow(
        string ProductId,
        string SourceTitle,
        string? EditorialTitle,
        string? EditorialDescription,
        string? VerifiedSize,
        string? VerifiedOptions,
        string? VerificationEvidence,
        string? ImageUrl,
        DateTimeOffset RefreshedUtc,
        decimal? SalePrice,
        string? Currency,
        decimal? CommissionRate,
        long? Volume,
        DateTimeOffset? LastDetailRefreshedUtc,
        int MediaCount,
        ProductAvailabilityState AvailabilityState,
        DateTimeOffset? LastCheckedUtc,
        int ConsecutiveUnavailableChecks,
        ProductReviewStatus ReviewStatus,
        string? SerializedFlags,
        bool IsFeatured,
        int DisplayOrder,
        int? CurrentEditorialVersionNumber,
        EditorialValidationState EditorialValidationState,
        byte[] RowVersion,
        bool HasActiveLink)
    {
        public IReadOnlyList<ProductQualityFlag> Flags => ProductQualityAssessmentService.ReadFlags(SerializedFlags);
        public string DisplayTitle => EditorialTitle ?? SourceTitle;
        public bool HasEditorialContent => !string.IsNullOrWhiteSpace(EditorialTitle) || !string.IsNullOrWhiteSpace(EditorialDescription);
        public bool HasVerifiedFacts => !string.IsNullOrWhiteSpace(VerifiedSize) || !string.IsNullOrWhiteSpace(VerifiedOptions);
        public bool CanApprove => Flags.Count == 0 && HasActiveLink;
        public bool IsClearReviewCandidate => Flags.Count == 0 && HasActiveLink && ReviewStatus is ProductReviewStatus.Pending or ProductReviewStatus.NeedsReview;
    }
}
