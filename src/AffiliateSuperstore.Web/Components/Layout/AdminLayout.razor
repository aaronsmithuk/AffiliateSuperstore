@inherits LayoutComponentBase
@inject AffiliateSuperstore.Core.Shops.AffiliateSuperstoreOptions SuperstoreOptions

<div class="admin-shell">
    <aside class="admin-sidebar">
        <a class="admin-brand" href="/admin/api-test">
            <span class="brand-mark">WA</span>
            <span>
                <strong>@SuperstoreOptions.BrandName</strong>
                <small>Control room</small>
            </span>
        </a>

        <nav class="admin-nav" aria-label="Admin navigation">
            <NavLink href="/admin/api-test">
                <span aria-hidden="true">⌁</span>
                API test lab
            </NavLink>
            <NavLink href="/admin/database">
                <span aria-hidden="true">◉</span>
                Database
            </NavLink>
            <NavLink href="/admin/catalogue">
                <span aria-hidden="true">▦</span>
                Catalogue
            </NavLink>
            <NavLink href="/admin/automation">
                <span aria-hidden="true">◷</span>
                Automation
            </NavLink>
            <NavLink href="/admin/identity">
                <span aria-hidden="true">≋</span>
                Product identity
            </NavLink>
            <NavLink href="/admin/performance">
                <span aria-hidden="true">↗</span>
                Performance
            </NavLink>
            <NavLink href="/admin/orders">
                <span aria-hidden="true">◫</span>
                Orders
            </NavLink>
        </nav>

        <div class="admin-sidebar-note">
            <AuthorizeView Policy="@AdminAuthorization.PolicyName" Context="owner">
                <Authorized>
                    <strong>@owner.User.Identity?.Name</strong>
                    <span>Authenticated administrator</span>
                    <a class="admin-signout-link" href="/admin/logout">Sign out</a>
                </Authorized>
            </AuthorizeView>
        </div>
    </aside>

    <main class="admin-main">
        @Body
    </main>
</div>
