@page "/{shopSlug}"
@model AffiliateSuperstore.Web.Pages.ShopModel
@{
    ViewData["Title"] = Model.Shop.SeoTitle;
    ViewData["Description"] = Model.Shop.SeoDescription;
    ViewData["Robots"] = Model.IsIndexable && !Model.HasActiveFilters ? "index,follow" : "noindex,follow";
    ViewData["Canonical"] = Model.CanonicalUrl;
    ViewData["StructuredData"] = Model.StructuredDataJson;
}

<div class="shop-shell" data-theme="@Model.Shop.Theme.Profile" data-analytics-page="catalogue" data-analytics-shop="@Model.Shop.Slug" data-analytics-currency="GBP" data-analytics-result-count="@Model.ResultCount" data-analytics-search-used="@((Model.Query is not null).ToString().ToLowerInvariant())" data-analytics-category-used="@((Model.Category is not null).ToString().ToLowerInvariant())" data-analytics-price-used="@((Model.MinimumPrice is not null || Model.MaximumPrice is not null).ToString().ToLowerInvariant())" data-analytics-sort="@Model.Sort" style="--theme-brand:@Model.Shop.Theme.PrimaryColour; --theme-accent:@Model.Shop.Theme.AccentColour; --theme-canvas:@Model.Shop.Theme.CanvasColour; --theme-surface:@Model.Shop.Theme.SurfaceColour; --theme-text:@Model.Shop.Theme.TextColour">
    <header class="shop-hero">
        <div class="shop-hero-copy">
            <nav class="shop-breadcrumb" aria-label="Breadcrumb"><a href="/">Shops</a><span aria-hidden="true">/</span><span>@Model.Shop.DisplayName</span></nav>
            <p class="shop-kicker">A softer corner of Wonder Aisle</p>
            <h1>@Model.Shop.Theme.LogoText</h1>
            <p class="shop-tagline">Meet your next favourite</p>
            <p class="shop-description">@Model.Shop.SeoDescription</p>
        </div>
        <div class="shop-hero-visual" aria-hidden="true">
            <span class="plush-character plush-character-small"></span>
            <span class="plush-character plush-character-main"></span>
            <span class="plush-character plush-character-tall"></span>
            <span class="shop-hero-spark">✦</span>
            <small>Picked for personality</small>
        </div>
        <form class="shop-search" method="get" action="@Model.Shop.PathPrefix" role="search" data-analytics-search data-analytics-shop="@Model.Shop.Slug">
            <label class="visually-hidden" for="shop-search">Search @Model.Shop.DisplayName</label>
            <input id="shop-search" name="q" value="@(Model.Query ?? string.Empty)" placeholder="Search plushies" />
            <button type="submit">Search</button>
        </form>
        <a class="saved-list-link" href="/basket/@Model.Shop.Slug"><span aria-hidden="true">♡</span> Saved <strong>@Model.SavedCount</strong></a>
    </header>

    @if (Model.Collections.Count > 0)
    {
        <nav class="shop-categories" aria-label="Browse plush collections">
            <a class="shop-category-link is-active" href="@Model.Shop.PathPrefix" aria-current="page"><span aria-hidden="true">✦</span> All plushies</a>
            @foreach (var collection in Model.Collections)
            {
                <a class="shop-category-link" href="/@Model.Shop.Slug/@collection.Slug" title="@collection.ShortDescription">@collection.DisplayName <span>@collection.ProductCount</span></a>
            }
        </nav>
    }
    else if (Model.Categories.Count > 1)
    {
        <nav class="shop-categories" aria-label="Browse plush categories">
            <a class="shop-category-link @(Model.Category is null ? "is-active" : null)" href="@Model.Shop.PathPrefix" aria-current="@(Model.Category is null ? "page" : null)"><span aria-hidden="true">✦</span> All plushies</a>
            @foreach (var category in Model.Categories)
            {
                <a class="shop-category-link @(category == Model.Category ? "is-active" : null)" href="@($"{Model.Shop.PathPrefix}?category={Uri.EscapeDataString(category)}")" aria-current="@(category == Model.Category ? "page" : null)">@Model.CategoryDisplayName(category)</a>
            }
        </nav>
    }

    <aside class="partner-notice" aria-label="Buying through a partner">
        <span class="partner-notice-icon" aria-hidden="true">◇</span>
        <div><strong>A quick note before you shop</strong><p>Links marked “Ad” are affiliate links. If you buy, we may earn a commission at no extra cost to you. AliExpress confirms options, delivery and the final total.</p></div>
    </aside>

    <div class="catalogue-layout">
        <details class="catalogue-filters" open>
            <summary><span>Filters</span>@if (Model.HasActiveFilters) { <strong>Active</strong> }</summary>
            <form class="catalogue-filter-bar" method="get" action="@Model.Shop.PathPrefix" data-analytics-filter data-analytics-shop="@Model.Shop.Slug">
                @if (Model.Query is not null) { <input type="hidden" name="q" value="@Model.Query" /> }
                @if (Model.Categories.Count > 1)
                {
                    <label>Category<select name="category"><option value="">All plushies</option>@foreach (var category in Model.Categories) { <option value="@category" selected="@(category == Model.Category)">@Model.CategoryDisplayName(category)</option> }</select></label>
                }
                <div class="filter-price-range">
                    <label>Minimum price<input type="number" name="minPrice" value="@Model.MinimumPrice" min="0" max="10000" step="0.01" placeholder="£0" /></label>
                    <label>Maximum price<input type="number" name="maxPrice" value="@Model.MaximumPrice" min="0" max="10000" step="0.01" placeholder="Any" /></label>
                </div>
                <label>Sort<select name="sort"><option value="popular" selected="@(Model.Sort == "popular")">Most popular</option><option value="price-asc" selected="@(Model.Sort == "price-asc")">Price: low to high</option><option value="price-desc" selected="@(Model.Sort == "price-desc")">Price: high to low</option><option value="newest" selected="@(Model.Sort == "newest")">Recently refreshed</option></select></label>
                <div class="filter-actions"><button type="submit">Apply filters</button>@if (Model.HasActiveFilters) { <a href="@Model.Shop.PathPrefix">Clear all</a> }</div>
            </form>
        </details>

        <section class="catalogue-results" aria-labelledby="catalogue-heading">
            <header class="catalogue-results-header">
                <div><p class="shop-kicker">Shop the collection</p><h2 id="catalogue-heading">@(Model.Query is null ? "Plushies chosen with care" : $"Results for “{Model.Query}”")</h2></div>
                <p><strong>@Model.ResultCount</strong> @(Model.ResultCount == 1 ? "result" : "results")</p>
            </header>

            @if (Model.HasActiveFilters)
            {
                <div class="active-filters" aria-label="Active filters">
                    @if (Model.Query is not null) { <span>Search: @Model.Query</span> }
                    @if (Model.Category is not null) { <span>@Model.Category</span> }
                    @if (Model.MinimumPrice is not null) { <span>From £@Model.MinimumPrice.Value.ToString("N2")</span> }
                    @if (Model.MaximumPrice is not null) { <span>To £@Model.MaximumPrice.Value.ToString("N2")</span> }
                    <a href="@Model.Shop.PathPrefix">Clear all</a>
                </div>
            }

            @if (Model.Products.Count == 0)
            {
                <section class="catalogue-empty" aria-labelledby="empty-heading"><span aria-hidden="true">♡</span><h2 id="empty-heading">No plushies found</h2><p>Try a different search or clear your filters to see the full curated collection.</p><a href="@Model.Shop.PathPrefix">Clear filters</a></section>
            }
            else
            {
                <section class="product-grid" aria-label="Plush products">
                    @foreach (var product in Model.Products)
                    {
                        <article class="product-card @(product.IsSaved ? "is-saved" : null)" data-affiliate-impression data-impression-shop="@Model.Shop.Slug" data-impression-product="@product.ProductId" data-impression-placement="product-card" data-analytics-item data-analytics-item-id="@product.ProductId" data-analytics-item-category="@product.Category" data-analytics-item-price="@(product.Price?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))" data-analytics-shop="@Model.Shop.Slug" data-analytics-placement="shop_catalogue">
                            <div class="product-card-media">
                                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                {
                                    <a class="product-image-link" href="/@Model.Shop.Slug/product/@product.ProductId" data-analytics-select-item data-analytics-item-id="@product.ProductId" data-analytics-item-category="@product.Category" data-analytics-item-price="@(product.Price?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))" data-analytics-shop="@Model.Shop.Slug" data-analytics-placement="shop_catalogue"><img src="@product.ImageUrl" alt="@product.Title" loading="lazy" referrerpolicy="no-referrer" /></a>
                                }
                                else
                                {
                                    <a class="product-image-link product-image-placeholder" href="/@Model.Shop.Slug/product/@product.ProductId" data-analytics-select-item data-analytics-item-id="@product.ProductId" data-analytics-item-category="@product.Category" data-analytics-item-price="@(product.Price?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))" data-analytics-shop="@Model.Shop.Slug" data-analytics-placement="shop_catalogue">
                                        <span>Image unavailable</span>
                                    </a>
                                }
                                @if (product.IsSaved)
                                {
                                    <a class="product-save-control is-saved" href="/basket/@Model.Shop.Slug" aria-label="@product.Title is saved"><span aria-hidden="true">♥</span><span class="visually-hidden">Saved</span></a>
                                }
                                else
                                {
                                    <form class="product-save-form" method="post" asp-page="/Basket" asp-page-handler="Add" asp-route-shopSlug="@Model.Shop.Slug" asp-route-productId="@product.ProductId" data-analytics-save-item data-analytics-item-id="@product.ProductId" data-analytics-item-category="@product.Category" data-analytics-item-price="@(product.Price?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))" data-analytics-shop="@Model.Shop.Slug" data-analytics-placement="shop_catalogue"><button class="product-save-control" type="submit" aria-label="Save @product.Title to your list"><span aria-hidden="true">♡</span></button></form>
                                }
                            </div>
                            <div class="product-card-copy">
                                <h3><a class="product-title-link" href="/@Model.Shop.Slug/product/@product.ProductId" data-analytics-select-item data-analytics-item-id="@product.ProductId" data-analytics-item-category="@product.Category" data-analytics-item-price="@(product.Price?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))" data-analytics-shop="@Model.Shop.Slug" data-analytics-placement="shop_catalogue">@product.Title</a></h3>
                                <p class="product-card-price">@Model.FormatPrice(product.Price, product.Currency)</p>
                                @if (product.EvaluationRate is not null || product.RecentSalesVolume is not null)
                                {
                                    <p class="product-card-confidence">@if (product.EvaluationRate is not null) { <span>★ @product.EvaluationRate.Value.ToString("P0") positive</span> }@if (product.RecentSalesVolume is not null) { <span>@product.RecentSalesVolume.Value.ToString("N0") sold</span> }</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(product.SellerName)) { <p class="product-card-seller">@product.SellerName</p> }
                                <a class="affiliate-product-link" href="/go/@Model.Shop.Slug/@product.ProductId?placement=product-card" rel="sponsored nofollow noopener" data-analytics-affiliate-click data-analytics-item-id="@product.ProductId" data-analytics-item-category="@product.Category" data-analytics-item-price="@(product.Price?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))" data-analytics-shop="@Model.Shop.Slug" data-analytics-placement="product-card">Ad · Check at AliExpress <span aria-hidden="true">↗</span></a>
                            </div>
                        </article>
                    }
                </section>
            }
        </section>
    </div>

    <section class="shop-guidance" aria-labelledby="shop-guidance-heading">
        <header>
            <p class="shop-kicker">A little help choosing</p>
            <h2 id="shop-guidance-heading">What we look for—and what to check.</h2>
            <p>Wonder Aisle shortlists products using clear imagery, current catalogue data, seller feedback and recent sales signals. We do not physically test the products.</p>
        </header>
        <ul>
            <li><span aria-hidden="true">01</span><strong>Check the size</strong><p>Plushies can look larger in photos. <a href="/plushies/size-guide">Compare common plush sizes</a>, then confirm the chosen option before ordering.</p></li>
            <li><span aria-hidden="true">02</span><strong>Choose your option</strong><p>Colours, characters and sizes may have different prices. AliExpress shows the final price for the option you select.</p></li>
            <li><span aria-hidden="true">03</span><strong>Review delivery</strong><p>Check the delivery estimate, tax and any import charges for your address before completing checkout.</p></li>
        </ul>
    </section>

    <aside class="affiliate-disclosure">
        <strong>Affiliate advertising disclosure</strong>
        <p>@SuperstoreOptions.BrandName earns a commission from qualifying purchases at no extra cost to you. We are not the seller, importer or AliExpress.</p>
    </aside>
</div>
