@page "/{shopSlug}"
@model AffiliateSuperstore.Web.Pages.ShopModel
@{
    ViewData["Title"] = Model.Shop.SeoTitle;
    ViewData["Description"] = Model.Shop.SeoDescription;
    ViewData["Robots"] = "noindex,nofollow";
}

<div class="shop-shell" style="--shop-primary:@Model.Shop.Theme.PrimaryColour; --shop-accent:@Model.Shop.Theme.AccentColour">
    <section class="shop-hero">
        <p class="shop-kicker">First shop configuration is live</p>
        <h1>@Model.Shop.Theme.LogoText</h1>
        <p>@Model.Shop.SeoDescription</p>
        <form class="shop-search" method="get" action="@Model.Shop.PathPrefix">
            <label class="visually-hidden" for="shop-search">Search @Model.Shop.DisplayName</label>
            <input id="shop-search" name="q" value="@(Model.Query ?? string.Empty)" placeholder="Search plushies" />
            <button type="submit">Search catalogue</button>
        </form>
        <a class="saved-list-link" href="/basket/@Model.Shop.Slug">Saved list <span>@Model.SavedCount</span></a>
    </section>

    <form class="catalogue-filter-bar" method="get" action="@Model.Shop.PathPrefix">
        @if (Model.Query is not null) { <input type="hidden" name="q" value="@Model.Query" /> }
        <label>Category<select name="category"><option value="">All categories</option>@foreach (var category in Model.Categories) { <option value="@category" selected="@(category == Model.Category)">@category</option> }</select></label>
        <label>Minimum price<input type="number" name="minPrice" value="@Model.MinimumPrice" min="0" max="10000" step="0.01" placeholder="£0" /></label>
        <label>Maximum price<input type="number" name="maxPrice" value="@Model.MaximumPrice" min="0" max="10000" step="0.01" placeholder="Any" /></label>
        <label>Sort<select name="sort"><option value="popular" selected="@(Model.Sort == "popular")">Most popular</option><option value="price-asc" selected="@(Model.Sort == "price-asc")">Price: low to high</option><option value="price-desc" selected="@(Model.Sort == "price-desc")">Price: high to low</option><option value="newest" selected="@(Model.Sort == "newest")">Recently refreshed</option></select></label>
        <button type="submit">Apply filters</button>
        @if (Model.Query is not null || Model.Category is not null || Model.MinimumPrice is not null || Model.MaximumPrice is not null || Model.Sort != "popular") { <a href="@Model.Shop.PathPrefix">Clear</a> }
    </form>

    @if (Model.Products.Count == 0)
    {
        <section class="shop-progress" aria-label="MVP progress">
            <article><span>01</span><strong>Catalogue review</strong><p>Imported products stay private until they pass curation in the admin.</p></article>
            <article><span>02</span><strong>Shopping list</strong><p>Keep interesting products together without creating an account.</p></article>
            <article><span>03</span><strong>AliExpress checkout</strong><p>Each purchase is completed directly and securely on AliExpress.</p></article>
        </section>
    }
    else
    {
        <section class="product-grid" aria-label="Plush products">
            @foreach (var product in Model.Products)
            {
                <article class="product-card">
                    @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                    {
                        <a class="product-image-link" href="/@Model.Shop.Slug/product/@product.ProductId"><img src="@product.ImageUrl" alt="" loading="lazy" referrerpolicy="no-referrer" /></a>
                    }
                    <div><h2><a class="product-title-link" href="/@Model.Shop.Slug/product/@product.ProductId">@product.Title</a></h2><p>@(product.Price is null ? "Check current price" : $"{product.Currency ?? "GBP"} {product.Price:N2}")</p><a class="affiliate-product-link" href="/go/@Model.Shop.Slug/@product.ProductId?placement=product-card" rel="sponsored nofollow noopener">View on AliExpress <span aria-hidden="true">↗</span></a><form method="post" asp-page="/Basket" asp-page-handler="Add" asp-route-shopSlug="@Model.Shop.Slug" asp-route-productId="@product.ProductId"><button type="submit">Save to your list</button></form></div>
                </article>
            }
        </section>
    }

    <aside class="affiliate-disclosure">
        <strong>How this shop works</strong>
        <p>This is an affiliate shop, not the seller. Product purchases and checkout take place on AliExpress. We may earn a commission from qualifying purchases at no extra cost to you.</p>
    </aside>
</div>
