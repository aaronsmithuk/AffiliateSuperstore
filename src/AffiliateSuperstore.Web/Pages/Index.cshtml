@page
@model IndexModel
@{
    var canonicalUrl = SuperstoreOptions.BuildPublicUrl();
    var description = "Explore Wonder Aisle: small, specialist shops with thoughtfully chosen finds, starting with plush toys and collectable companions.";
    ViewData["Title"] = "Curated shops for thoughtful finds";
    ViewData["Description"] = description;
    ViewData["Robots"] = "index,follow";
    ViewData["Canonical"] = canonicalUrl;
    ViewData["StructuredData"] = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "WebSite",
        ["name"] = SuperstoreOptions.BrandName,
        ["url"] = canonicalUrl,
        ["description"] = description
    });
}

<div class="wonder-home">
    <section class="wonder-home-hero" aria-labelledby="wonder-home-heading">
        <div class="wonder-home-hero-copy">
            <p class="wonder-home-kicker"><span aria-hidden="true">01</span> Thoughtful finds, easier to browse</p>
            <h1 id="wonder-home-heading">Good finds, gathered with care.</h1>
            <p class="wonder-home-lead">
                Explore small, specialist shops filled with things worth a closer look—starting with
                characterful plush toys, cosy favourites and collectable companions.
            </p>
            <div class="wonder-home-actions">
                <a class="wonder-home-primary-action" href="/plushies">Shop plushies <span aria-hidden="true">→</span></a>
                <a class="wonder-home-secondary-action" href="#shops">Browse Wonder Aisle <span aria-hidden="true">↓</span></a>
            </div>
        </div>
        <aside class="wonder-home-wayfinder" aria-label="Wonder Aisle directory">
            <div class="wonder-home-wayfinder-topline"><span>Wonder Aisle</span><span>First stop</span></div>
            <p aria-hidden="true">W<span>/</span>A</p>
            <div class="wonder-home-wayfinder-bottomline"><span>The Plushy Shop</span><span>Open now</span></div>
        </aside>
    </section>

    <section class="wonder-home-shops" id="shops" aria-labelledby="wonder-home-shops-heading">
        <header class="wonder-home-section-heading">
            <div>
                <p class="wonder-home-kicker"><span aria-hidden="true">02</span> Browse Wonder Aisle</p>
                <h2 id="wonder-home-shops-heading">One lovely place to start.</h2>
            </div>
            <p>Each shop has its own point of view and a collection shaped to make choosing feel lighter.</p>
        </header>

        @foreach (var shop in Model.Shops)
        {
            <article class="wonder-aisle-card" style="--aisle-colour:@shop.PrimaryColour; --aisle-accent:@shop.AccentColour">
                <a class="wonder-aisle-card-media" href="@shop.Path" aria-label="Enter @shop.DisplayName">
                    @if (shop.PreviewImages.Count > 0)
                    {
                        <span class="wonder-aisle-image-grid wonder-aisle-image-grid-@Math.Min(shop.PreviewImages.Count, 3)" aria-hidden="true">
                            @foreach (var imageUrl in shop.PreviewImages.Take(3))
                            {
                                <img src="@imageUrl" alt="" loading="@(shop.Order == 1 ? "eager" : "lazy")" referrerpolicy="no-referrer" />
                            }
                        </span>
                    }
                    else
                    {
                        <span class="wonder-aisle-placeholder" aria-hidden="true">
                            <small>Specialist shop</small>
                            <strong>@shop.DisplayName</strong>
                            <span>Curated with care</span>
                        </span>
                    }
                    <span class="wonder-aisle-number" aria-hidden="true">@shop.Order.ToString("00")</span>
                </a>
                <div class="wonder-aisle-card-copy">
                    <p class="wonder-aisle-status"><span aria-hidden="true"></span> Now open</p>
                    <h3><a href="@shop.Path">@shop.DisplayName</a></h3>
                    <p>@shop.Description</p>
                    <ul aria-label="Shop highlights">
                        @foreach (var highlight in shop.Highlights)
                        {
                            <li>@highlight</li>
                        }
                    </ul>
                    <a class="wonder-aisle-enter" href="@shop.Path">Enter the shop <span aria-hidden="true">→</span></a>
                    <small>Browse here. Checkout is completed with our retail partner.</small>
                </div>
            </article>
        }
    </section>

    <section class="wonder-home-values" aria-labelledby="wonder-home-values-heading">
        <div class="wonder-home-values-intro">
            <p class="wonder-home-kicker"><span aria-hidden="true">03</span> Why Wonder Aisle</p>
            <h2 id="wonder-home-values-heading">Less endless scrolling.<br />More to love.</h2>
        </div>
        <ol>
            <li><span>01</span><strong>Focused shops</strong><p>Each aisle is built around one subject, not a bit of everything.</p></li>
            <li><span>02</span><strong>Thoughtful shortlists</strong><p>Collections are reviewed and organised before they reach the shop floor.</p></li>
            <li><span>03</span><strong>No checkout surprises</strong><p>We show you the finds; our retail partner confirms options, delivery and the final total.</p></li>
        </ol>
    </section>

    <section class="wonder-home-growing" aria-labelledby="wonder-home-growing-heading">
        <div>
            <p class="wonder-home-kicker">First stop: plushies</p>
            <h2 id="wonder-home-growing-heading">Start somewhere soft.</h2>
        </div>
        <p>Meet cheerful characters, cuddly classics and curious little companions in the first Wonder Aisle shop.</p>
        <a href="/plushies">Visit The Plushy Shop <span aria-hidden="true">→</span></a>
    </section>
</div>
