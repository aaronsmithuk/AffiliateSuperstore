<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @SuperstoreOptions.BrandName</title>
    @if (ViewData["Description"] is string description)
    {
        <meta name="description" content="@description" />
    }
    @if (ViewData["Robots"] is string robots)
    {
        <meta name="robots" content="@robots" />
    }
    @if (ViewData["Canonical"] is string canonical)
    {
        <link rel="canonical" href="@canonical" />
    }
    @if (ViewData["StructuredData"] is string structuredData)
    {
        <script type="application/ld+json">@Html.Raw(structuredData)</script>
    }
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AffiliateSuperstore.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="site-navigation" aria-label="Primary navigation">
            <a class="site-brand" href="/"><span aria-hidden="true">WA</span><strong>@SuperstoreOptions.BrandName</strong></a>
            <ul class="site-links">
                <li><a href="/">Home</a></li>
                <li><a href="/plushies">Plushies</a></li>
                <li><a href="/basket/plushies">Saved list</a></li>
                <li><a href="/Privacy">Privacy</a></li>
                <li><a class="site-admin-link" href="/admin/api-test">Admin</a></li>
            </ul>
        </nav>
    </header>
    <div class="site-frame">
        <main role="main" class="site-main">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div>
            &copy; 2026 - @SuperstoreOptions.BrandName - <a href="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
