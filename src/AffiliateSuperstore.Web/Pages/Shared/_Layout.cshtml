<!DOCTYPE html>
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject AffiliateSuperstore.Web.Services.WebAnalyticsOptions WebAnalytics
@{
    var antiforgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var googleMeasurementId = WebAnalytics.IsConfigured
        ? WebAnalytics.NormalizedGoogleMeasurementId
        : null;
    var pageTitle = ViewData["Title"] as string ?? SuperstoreOptions.BrandName;
    var pageDescription = ViewData["Description"] as string;
    var canonicalUrl = ViewData["Canonical"] as string;
    var socialImageUrl = ViewData["SocialImage"] as string ?? SuperstoreOptions.BuildPublicUrl("/images/wonder-aisle-social.png");
    var socialImageAlt = ViewData["SocialImageAlt"] as string ?? "A curated display of characterful plush animals at Wonder Aisle.";
    var socialImageWidth = ViewData["SocialImageWidth"] as int? ?? 1200;
    var socialImageHeight = ViewData["SocialImageHeight"] as int? ?? 630;
    var currentPath = Context.Request.Path;
    var isHome = currentPath == "/";
    var isPlushies = currentPath.StartsWithSegments("/plushies");
    var isSaved = currentPath.StartsWithSegments("/basket");
}
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - @SuperstoreOptions.BrandName</title>
    @if (pageDescription is not null)
    {
        <meta name="description" content="@pageDescription" />
    }
    @if (ViewData["Robots"] is string robots)
    {
        <meta name="robots" content="@robots" />
    }
    @if (canonicalUrl is not null)
    {
        <link rel="canonical" href="@canonicalUrl" />
    }
    <meta property="og:site_name" content="@SuperstoreOptions.BrandName" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@pageTitle" />
    @if (pageDescription is not null)
    {
        <meta property="og:description" content="@pageDescription" />
    }
    @if (canonicalUrl is not null)
    {
        <meta property="og:url" content="@canonicalUrl" />
    }
    <meta property="og:image" content="@socialImageUrl" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="@socialImageWidth" />
    <meta property="og:image:height" content="@socialImageHeight" />
    <meta property="og:image:alt" content="@socialImageAlt" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@pageTitle" />
    @if (pageDescription is not null)
    {
        <meta name="twitter:description" content="@pageDescription" />
    }
    <meta name="twitter:image" content="@socialImageUrl" />
    <meta name="twitter:image:alt" content="@socialImageAlt" />
    @if (ViewData["StructuredData"] is string structuredData)
    {
        <script type="application/ld+json">@Html.Raw(structuredData)</script>
    }
    <script type="importmap"></script>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#163b34" />
    <meta name="request-verification-token" content="@antiforgeryToken" />
    @if (googleMeasurementId is not null)
    {
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('consent', 'default', {
                'analytics_storage': 'denied',
                'ad_storage': 'denied',
                'ad_user_data': 'denied',
                'ad_personalization': 'denied'
            });
        </script>
    }
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AffiliateSuperstore.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="site-navigation" aria-label="Primary navigation">
            <a class="site-brand" href="/" aria-label="@SuperstoreOptions.BrandName home">
                <span class="site-brand-badge"><img class="site-brand-mark" src="~/favicon.svg" alt="" aria-hidden="true" /></span>
                <span class="site-brand-copy"><strong>@SuperstoreOptions.BrandName</strong><small>Small shops, good finds</small></span>
            </a>
            <ul class="site-links">
                <li><a class="@(isHome ? "is-current" : null)" href="/#shops" aria-current="@(isHome ? "page" : null)">Shops</a></li>
                <li><a class="@(isPlushies ? "is-current" : null)" href="/plushies" aria-current="@(isPlushies ? "page" : null)">Plushies</a></li>
                <li><a class="site-saved-link @(isSaved ? "is-current" : null)" href="/basket/plushies" aria-current="@(isSaved ? "page" : null)"><span aria-hidden="true">♡</span> Saved</a></li>
            </ul>
        </nav>
    </header>
    <div class="site-frame">
        <main role="main" class="site-main">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div>
            <span>&copy; 2026 @SuperstoreOptions.BrandName</span>
            <span><a href="/about">About</a> · <a href="/how-we-curate">How we curate</a> · <a href="/plushies/size-guide">Plush size guide</a> · <a href="/contact">Contact</a></span>
            <span><a href="/Privacy">Privacy &amp; cookies</a> · <a href="/Terms">Website terms</a>@if (googleMeasurementId is not null) { <text> · <button class="cookie-settings-link" type="button" data-cookie-settings>Cookie settings</button></text> }</span>
            @if (!string.IsNullOrWhiteSpace(LegalNotice.OperatorName))
            {
                <span>Operated by @LegalNotice.OperatorName@if (!string.IsNullOrWhiteSpace(LegalNotice.CompanyNumber)) { <text> · Company @LegalNotice.CompanyNumber</text> }</span>
            }
            else
            {
                <span class="legal-configuration-warning">Legal operator details must be configured before publication.</span>
            }
        </div>
    </footer>

    @if (googleMeasurementId is not null)
    {
        <section class="cookie-consent" data-cookie-consent data-measurement-id="@googleMeasurementId" aria-labelledby="cookie-consent-title" aria-describedby="cookie-consent-description" hidden>
            <div class="cookie-consent-copy">
                <p class="cookie-consent-kicker">Your privacy</p>
                <h2 id="cookie-consent-title">Optional analytics</h2>
                <p id="cookie-consent-description">With your permission, Google Analytics helps us understand which pages are useful. We do not load it unless you accept. Rejecting has no effect on the shop.</p>
                <a href="/Privacy#analytics-cookies">Read our privacy and cookie notice</a>
            </div>
            <div class="cookie-consent-actions">
                <button type="button" data-cookie-consent-choice="rejected">Reject analytics</button>
                <button type="button" data-cookie-consent-choice="accepted">Accept analytics</button>
            </div>
        </section>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
