@page "/{shopSlug}/product/{productId}"
@model AffiliateSuperstore.Web.Pages.ProductModel
@{
    ViewData["Title"] = Model.Product.Title;
    ViewData["Description"] = Model.Product.EditorialDescription ?? $"View {Model.Product.Title} from {Model.Shop.DisplayName}. Checkout takes place on AliExpress.";
    ViewData["Robots"] = "noindex,nofollow";
}

<article class="shop-shell product-detail" style="--shop-primary:@Model.Shop.Theme.PrimaryColour; --shop-accent:@Model.Shop.Theme.AccentColour">
    <nav class="product-breadcrumb" aria-label="Breadcrumb"><a href="@Model.Shop.PathPrefix">@Model.Shop.DisplayName</a><span aria-hidden="true">/</span><span>@(Model.Product.SecondCategory ?? "Product")</span></nav>
    <div class="product-detail-grid">
        <div class="product-detail-media">@if (!string.IsNullOrWhiteSpace(Model.Product.ImageUrl)) { <img src="@Model.Product.ImageUrl" alt="@Model.Product.Title" referrerpolicy="no-referrer" /> }</div>
        <div class="product-detail-copy">
            <p class="shop-kicker">Curated affiliate listing</p>
            <h1>@Model.Product.Title</h1>
            @if (!string.IsNullOrWhiteSpace(Model.Product.EditorialDescription)) { <p class="product-description">@Model.Product.EditorialDescription</p> }
            <div class="product-price"><strong>@(Model.Product.SalePrice is null ? "Check current price" : $"{Model.Product.Currency ?? "GBP"} {Model.Product.SalePrice:N2}")</strong>@if (Model.Product.OriginalPrice > Model.Product.SalePrice) { <del>@(Model.Product.Currency ?? "GBP") @Model.Product.OriginalPrice?.ToString("N2")</del> }@if (!string.IsNullOrWhiteSpace(Model.Product.Discount)) { <span>@Model.Product.Discount</span> }</div>
            <dl class="product-facts">
                @if (Model.Product.RecentSalesVolume is not null) { <div><dt>Recent sales</dt><dd>@Model.Product.RecentSalesVolume.Value.ToString("N0")</dd></div> }
                @if (Model.Product.EvaluationRate is not null) { <div><dt>Positive rating</dt><dd>@Model.Product.EvaluationRate.Value.ToString("P0")</dd></div> }
                @if (!string.IsNullOrWhiteSpace(Model.Product.SellerName)) { <div><dt>AliExpress seller</dt><dd>@Model.Product.SellerName</dd></div> }
                <div><dt>Price checked</dt><dd>@Model.Product.LastCheckedUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd></div>
            </dl>
            <a class="product-primary-cta" href="/go/@Model.Shop.Slug/@Model.Product.ProductId?placement=product-page" rel="sponsored nofollow noopener">Check price and availability on AliExpress <span aria-hidden="true">↗</span></a>
            <form method="post" asp-page="/Basket" asp-page-handler="Add" asp-route-shopSlug="@Model.Shop.Slug" asp-route-productId="@Model.Product.ProductId"><button class="product-save-button" type="submit">Save to your list (@Model.SavedCount saved)</button></form>
            <p class="checkout-note">You will leave this shop and complete any purchase directly with AliExpress. Final price, variants, delivery and seller terms are confirmed there.</p>
        </div>
    </div>
    <aside class="affiliate-disclosure"><strong>Affiliate disclosure</strong><p>We may earn a commission from qualifying purchases at no extra cost to you. We are not the seller and do not handle payment, delivery or returns.</p></aside>
</article>
