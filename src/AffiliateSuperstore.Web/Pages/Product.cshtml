@page "/{shopSlug}/product/{productId}"
@model AffiliateSuperstore.Web.Pages.ProductModel
@{
    ViewData["Title"] = Model.Product.Title;
    ViewData["Description"] = Model.Product.EditorialDescription ?? $"View {Model.Product.Title} from {Model.Shop.DisplayName}. Checkout takes place on AliExpress.";
    ViewData["Robots"] = Model.IsIndexable ? "index,follow" : "noindex,follow";
    ViewData["Canonical"] = Model.CanonicalUrl;
    ViewData["StructuredData"] = Model.StructuredDataJson;
}

<article class="shop-shell product-detail" data-theme="@Model.Shop.Theme.Profile" style="--theme-brand:@Model.Shop.Theme.PrimaryColour; --theme-accent:@Model.Shop.Theme.AccentColour; --theme-canvas:@Model.Shop.Theme.CanvasColour; --theme-surface:@Model.Shop.Theme.SurfaceColour; --theme-text:@Model.Shop.Theme.TextColour">
    <header class="product-shop-header"><a href="@Model.Shop.PathPrefix"><span aria-hidden="true">←</span> @Model.Shop.Theme.LogoText</a><a href="/basket/@Model.Shop.Slug">Saved list <strong>@Model.SavedCount</strong></a></header>
    <nav class="product-breadcrumb" aria-label="Breadcrumb"><a href="/">Shops</a><span aria-hidden="true">/</span><a href="@Model.Shop.PathPrefix">@Model.Shop.DisplayName</a><span aria-hidden="true">/</span><span>@(Model.Product.SecondCategory ?? "Product")</span></nav>
    <div class="product-detail-grid">
        <div class="product-detail-media">
            @if (Model.Product.ImageUrls.Count > 0)
            {
                <div class="product-featured-image"><img data-product-main-image src="@Model.Product.ImageUrls[0]" alt="@Model.Product.Title" referrerpolicy="no-referrer" /></div>
                @if (Model.Product.ImageUrls.Count > 1)
                {
                    <div class="product-gallery" data-product-gallery aria-label="Choose a product image">
                        @for (var imageIndex = 0; imageIndex < Model.Product.ImageUrls.Count; imageIndex++)
                        {
                            var imageUrl = Model.Product.ImageUrls[imageIndex];
                            var imageNumber = imageIndex + 1;
                            <button type="button" data-gallery-image="@imageUrl" data-gallery-alt="@Model.Product.Title, image @imageNumber of @Model.Product.ImageUrls.Count" aria-label="Show image @imageNumber of @Model.Product.ImageUrls.Count" aria-pressed="@(imageIndex == 0 ? "true" : "false")"><img src="@imageUrl" alt="" loading="lazy" referrerpolicy="no-referrer" /></button>
                        }
                    </div>
                }
                @foreach (var videoUrl in Model.Product.VideoUrls)
                {
                    <video class="product-video" controls preload="metadata" playsinline><source src="@videoUrl" />Your browser cannot play this product video.</video>
                }
            }
            else
            {
                <div class="product-image-placeholder">Image unavailable</div>
            }
        </div>
        <div class="product-detail-copy">
            <p class="shop-kicker">Curated find</p>
            <h1>@Model.Product.Title</h1>
            @if (Model.Product.EvaluationRate is not null || Model.Product.RecentSalesVolume is not null)
            {
                <p class="product-confidence">@if (Model.Product.EvaluationRate is not null) { <span>★ @Model.Product.EvaluationRate.Value.ToString("P0") positive</span> }@if (Model.Product.RecentSalesVolume is not null) { <span>@Model.Product.RecentSalesVolume.Value.ToString("N0") sold recently</span> }</p>
            }
            <div class="product-price"><strong>@(Model.Product.SalePrice is null ? "Check current price" : $"{Model.Product.Currency ?? "GBP"} {Model.Product.SalePrice:N2}")</strong>@if (Model.Product.OriginalPrice > Model.Product.SalePrice) { <del>@(Model.Product.Currency ?? "GBP") @Model.Product.OriginalPrice?.ToString("N2")</del> }@if (!string.IsNullOrWhiteSpace(Model.Product.Discount)) { <span>@Model.Product.Discount</span> }</div>
            @if (!string.IsNullOrWhiteSpace(Model.Product.EditorialDescription)) { <p class="product-description">@Model.Product.EditorialDescription</p> }
            <dl class="product-facts">
                @if (!string.IsNullOrWhiteSpace(Model.Product.SellerName)) { <div><dt>AliExpress seller</dt><dd>@Model.Product.SellerName</dd></div> }
                @if (!string.IsNullOrWhiteSpace(Model.Product.SecondCategory ?? Model.Product.FirstCategory)) { <div><dt>Category</dt><dd>@(Model.Product.SecondCategory ?? Model.Product.FirstCategory)</dd></div> }
                @if (Model.Product.ImageUrls.Count > 1) { <div><dt>Listing gallery</dt><dd>@Model.Product.ImageUrls.Count product images</dd></div> }
                <div><dt>Product reference</dt><dd>@Model.Product.ProductId</dd></div>
                <div><dt>Price checked</dt><dd>@Model.Product.LastCheckedUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd></div>
                @if (Model.Product.LastDetailRefreshedUtc is not null) { <div><dt>Details checked</dt><dd>@Model.Product.LastDetailRefreshedUtc.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd></div> }
            </dl>
            <aside class="listing-data-note"><strong>About this listing data</strong><p>The score shown is AliExpress’s aggregate positive-feedback rate, not reviews collected by this shop. Available colours, sizes, delivery dates and the final price are confirmed on AliExpress.</p></aside>
            <div class="product-actions">
                <a class="product-primary-cta" href="/go/@Model.Shop.Slug/@Model.Product.ProductId?placement=product-page" rel="sponsored nofollow noopener">Check price &amp; availability at AliExpress <span aria-hidden="true">↗</span></a>
                @if (Model.IsSaved)
                {
                    <a class="product-save-button is-saved" href="/basket/@Model.Shop.Slug"><span aria-hidden="true">♥</span> Saved to your list</a>
                }
                else
                {
                    <form method="post" asp-page="/Basket" asp-page-handler="Add" asp-route-shopSlug="@Model.Shop.Slug" asp-route-productId="@Model.Product.ProductId"><button class="product-save-button" type="submit"><span aria-hidden="true">♡</span> Save for later</button></form>
                }
            </div>
            <aside class="partner-notice product-handoff" aria-label="Buying through a partner"><span class="partner-notice-icon" aria-hidden="true">◇</span><div><strong>Buying through a partner</strong><p>You’ll leave this shop to complete checkout with AliExpress.</p></div></aside>
        </div>
    </div>
    @if (Model.RelatedProducts.Count > 0)
    {
        <section class="related-products" aria-labelledby="related-heading">
            <header><p class="shop-kicker">Keep exploring</p><h2 id="related-heading">You might also like</h2></header>
            <div class="related-product-grid">
                @foreach (var product in Model.RelatedProducts)
                {
                    <article class="related-product-card">
                        <a href="/@Model.Shop.Slug/product/@product.ProductId">@if (!string.IsNullOrWhiteSpace(product.ImageUrl)) { <img src="@product.ImageUrl" alt="@product.Title" loading="lazy" referrerpolicy="no-referrer" /> }<strong>@product.Title</strong></a>
                        <p>@(product.Price is null ? "Check current price" : $"{product.Currency ?? "GBP"} {product.Price:N2}")</p>
                    </article>
                }
            </div>
        </section>
    }
    <aside class="affiliate-disclosure"><strong>Affiliate disclosure</strong><p>We may earn a commission from qualifying purchases at no extra cost to you. Affiliate Superstore is not the seller and does not handle payment, delivery or returns.</p></aside>
</article>
